.main-tabs {
  position: fixed;
  z-index: 90;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  border-top: 1px solid #e1e1de;
  background: #ffffff;
  padding: 8px 8px 12px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
}
.main-tabs-items { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); height: 56px; }
.main-tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  gap: 2px;
  margin: 0 7px;
  padding: 5px 0;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #65615c;
  font-size: 11px;
  font-weight: 400;
  line-height: 1.5;
  overflow: hidden;
}
.main-tab::after { border: 0; }
.main-tab.is-selected { background: #fff9e6; color: #231815; font-weight: 600; }
.main-tab.is-selected::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 18px;
  height: 3px;
  border-radius: 0 0 3px 3px;
  background: #fcc900;
  transform: translateX(-50%);
}
.main-tab-icon { display: block; width: 24px; height: 24px; }
.main-tab-icon, .main-tab-label { position: relative; z-index: 1; }
.main-tab-ripple {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(35,24,21,.10);
  pointer-events: none;
  animation: main-tab-water 180ms cubic-bezier(.2,.7,.2,1) both;
}
@keyframes main-tab-water {
  from { transform: translate(-50%,-50%) scale(0); opacity: 1; }
  to { transform: translate(-50%,-50%) scale(1); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) { .main-tab-ripple { animation: none; opacity: 0; } }
