.evidence {
  margin-top: 24rpx;
  padding-top: 4rpx;
}
.evidence-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e9e7e3;
  font-size: 28rpx;
  line-height: 1.7;
}
.decision {
  font-size: 28rpx;
  background: #f5f6f7;
  color: #231815;
  border: 1rpx solid #d2d2c8;
  padding: 20rpx 12rpx;
  line-height: 1.5;
  border-radius: 6rpx;
  width: 100%;
}
.decision.selected {
  border: 2rpx solid #231815;
  background: #fcc900;
}
.grid-2 {
  margin-bottom: 32rpx;
}
.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
.consent-row checkbox {
  flex-shrink: 0;
}
.evidence-count {
  margin-top: 20rpx;
}
.evidence-consent {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-height: 112rpx;
  padding: 24rpx 20rpx;
  margin-top: 20rpx;
  border: 2rpx solid #aaa79f;
  border-radius: 8rpx;
  background: #fff;
}
.evidence-consent.is-checked {
  border-color: #231815;
  background: #fff5cf;
}
.evidence-checkbox {
  flex-shrink: 0;
  transform: none;
}
.evidence-consent-title {
  font-size: 28rpx;
  line-height: 1.6;
  font-weight: 600;
}
.signing-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}
.signing-header .section-title {
  margin: 0;
}
.signing-message {
  margin: 24rpx 0 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}
.signing-card .secondary {
  margin-top: 24rpx;
}
.card .primary {
  margin-top: 28rpx;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}

/* Bright native 2026-11-02 */
.evidence-item{border-color:#e9e7e3;font-size:28rpx}.decision{border-radius:16rpx;min-height:92rpx;background:#ffffff;border-color:#cccac7}.decision.selected{border-color:#d9a400;background:#fcc900}.evidence-consent{border-radius:18rpx;border-color:#cccac7;padding:24rpx}.evidence-consent.is-checked{border-color:#d9a400;background:#fff6d8}.signing-message{word-break:normal;overflow-wrap:anywhere;font-size:28rpx}.signing-card{border-color:#e9e7e3}.page>.title{margin-bottom:20rpx}.card>.row>.section-title{font-size:32rpx}.card .price{font-size:36rpx;line-height:1.5;overflow-wrap:anywhere}
