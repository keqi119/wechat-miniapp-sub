<view class="page bottom-space"><view class="eyebrow">HANDOVER / 车辆交接</view><view class="title">核对，再确认。</view>
<view wx:if="{{loading}}" class="empty">正在读取交接信息…</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button class="secondary" bindtap="reload">重新加载</button><button class="text-button" bindtap="openUse">返回用车</button></view>
<view wx:elif="{{!handover}}" class="empty"><view class="section-title">暂无待办理的交接</view><button class="secondary" bindtap="openUse">返回用车</button></view>
<block wx:else><view class="notice">交接事实核对与交接单签署分别记录，实际交付以后台确认结果为准。</view>
<view class="card"><view class="label">交接车辆</view><view class="section-title">{{subscription.vehicleName}}</view><view class="muted">{{subscription.planTitle}}</view><view class="muted">交接编号 {{handover.id}}</view></view>
<view class="card"><view class="section-title">{{handover.actualAtLabel}}（北京时间）</view><view class="price">{{handover.actualAtDisplay}}</view><view class="muted small">该时间来自本交接版本，与证据清单一同确认；不会用当前时间替代。订阅月按已确认实际交车日起算。</view><view wx:if="{{!handover.actualAtValid}}" class="notice">无法确认新的交接事实，请联系后台核对时间或提出异议。已有意见与文件仍保留可查看。</view></view><view class="card"><view class="row between"><view class="section-title">01 / 阅读交接证据</view><text class="tag">{{evidenceRead ? '已阅读' : '待阅读'}}</text></view><button class="secondary" bindtap="showEvidence">{{evidenceOpen ? '收起交接证据' : '展开交接证据'}}</button>
<view wx:if="{{evidenceOpen}}" class="evidence"><view wx:for="{{handover.checklist}}" wx:key="label" class="evidence-item"><view class="label">{{item.label || item.title}}</view><view>{{item.value || item.description}}</view></view><button wx:for="{{handover.evidence}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="openEvidence">打开 {{item.name || '交接附件'}}</button><view class="muted">已打开 {{readFileIds.length}} / {{handover.fileIds.length}} 份附件</view><button class="text-button" bindtap="acknowledgeEvidence">{{evidenceRead ? '已阅读全部交接证据 ✓' : '我已阅读全部交接证据'}}</button></view></view>
<view wx:if="{{submitted}}" class="card"><view class="section-title">交接意见已保存</view><view class="muted">{{decision === 'dispute' ? '异议已提交后台处理。修订后会生成新的交接版本，请重新核对。' : handover.signatureStatus === 'SIGNED' ? '交接单已签署，交付完成以后台确认结果为准。' : '事实已确认，请继续签署交接单。'}}</view><button wx:if="{{decision === 'confirm' && handover.signatureStatus !== 'SIGNED' && handover.status !== 'COMPLETED' && handover.status !== 'SUPERSEDED'}}" class="primary" bindtap="sign" disabled="{{busy || !handover.actualAtValid}}">签署交接单</button><button wx:if="{{handover.signedFileId}}" class="secondary" bindtap="openSigned">查看签署交接单</button><button class="secondary" bindtap="openRecord">刷新交接状态</button></view>
<block wx:else><view class="card"><view class="section-title">02 / 选择交接意见</view><view class="grid-2"><button class="decision {{decision === 'confirm' ? 'selected' : ''}}" data-value="confirm" bindtap="selectDecision" disabled="{{busy}}">确认无异议</button><button class="decision {{decision === 'dispute' ? 'selected' : ''}}" data-value="dispute" bindtap="selectDecision" disabled="{{busy}}">提出异议</button></view>
<view class="field"><view class="label">确认人姓名</view><input class="input" value="{{name}}" maxlength="30" data-field="name" bindinput="input" disabled="{{busy}}"/></view><view class="field"><view class="label">{{decision === 'dispute' ? '异议说明（必填）' : '补充说明（选填）'}}</view><textarea class="textarea" value="{{note}}" maxlength="500" data-field="note" bindinput="input" disabled="{{busy}}"/></view>
<checkbox-group bindchange="consent"><label class="consent-row"><checkbox value="accepted" checked="{{accepted}}" disabled="{{busy}}" color="#252723"/><text>我已阅读当前交接证据，并确认提交当前意见。交接单须单独签署。</text></label></checkbox-group></view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || (decision === 'confirm' && !handover.actualAtValid)}}">{{decision === 'dispute' ? '提交异议' : '确认交接事实'}}</button></block><button class="text-button" bindtap="openUse">返回用车</button></block></view>
