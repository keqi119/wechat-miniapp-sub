<view class="page bottom-space"><view class="eyebrow">我的订阅</view><view class="title">换车结算</view><view class="subtitle">核对实际交接日期和本次费用。</view><view wx:if="{{loading}}" class="empty">正在读取…</view><view wx:if="{{error}}" class="notice">{{error}}</view><block wx:if="{{view}}"><view class="card"><view class="row between"><view class="section-title">实际交接</view><text class="tag">{{view.statusText}}</text></view><view class="field">旧车收回：{{view.returnedAtText}}</view><view class="field">新车交付：{{view.deliveredAtText}}</view></view><view class="card"><view class="section-title">本次费用</view><view class="field">租金补收：{{view.chargeText}}</view><view class="field">租金应退：{{view.refundText}}</view><view class="field">停租扣减：{{view.gapText}}</view><view class="field">押金：{{view.depositText}}</view><view class="field">换车服务费：{{view.feeText}}</view></view><view class="card"><view class="section-title">逐期明细</view><view wx:for="{{view.periods}}" wx:key="sequence" class="field"><view>第 {{item.sequence}} 期 · {{item.dates}}</view><view>应计 {{item.amountText}} · 补收 {{item.chargeText}} · 应退 {{item.refundText}}</view></view></view><view wx:if="{{view.reason}}" class="card"><view class="section-title">已留存的意见</view><view>{{view.reason}}</view></view><view wx:if="{{view.canRespond}}" class="card"><checkbox-group bindchange="accept"><label class="consent-row"><checkbox value="amount" checked="{{accepted}}" disabled="{{busy}}" color="#231815"/><text>我已核对实际交接及逐期金额。</text></label></checkbox-group><textarea placeholder="如有异议，请说明；解决原异议后确认，也请填写核对说明。" value="{{reason}}" maxlength="2000" bindinput="reason" disabled="{{busy}}"/><button class="primary" data-decision="CONFIRM" bindtap="respond" disabled="{{busy || !accepted}}">确认本版金额</button><button class="secondary" data-decision="OBJECT" bindtap="respond" disabled="{{busy || !reason}}">提交异议</button></view></block><view wx:if="{{message}}" class="notice">{{message}}</view><button class="text-button" bindtap="reload" disabled="{{busy}}">状态刷新</button></view>
