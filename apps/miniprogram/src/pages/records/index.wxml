<view class="page">
<button wx:if="{{type === 'contracts'}}" class="secondary" bindtap="openElectronicContracts">电子合同 / 签署与历史</button>

  
  <view class="eyebrow">{{type === 'addons' ? '订阅加购' : '我的记录'}}</view>
  <view class="title">{{title}}</view>
  <view wx:if="{{type === 'orderchanges'}}" class="row"><button class="{{changeKind === '' ? 'primary' : 'secondary'}}" data-kind="" bindtap="selectChangeKind">延期 / 换车</button><button class="{{changeKind === 'SUBSCRIPTION_EXTENSION' ? 'primary' : 'secondary'}}" data-kind="SUBSCRIPTION_EXTENSION" bindtap="selectChangeKind">同车续期</button></view>
  <view wx:if="{{loading}}" class="empty">正在读取记录…</view>
  <view wx:elif="{{error}}" class="empty">
    <view>{{error}}</view>
    <button class="secondary" bindtap="reload">重新加载</button>
    <button class="text-button" bindtap="openMine">返回我的</button>
  </view>
  <view wx:elif="{{type !== 'addons' && !items.length && !(type === 'entitlements' && (usage || swap))}}" class="empty">
    <view class="section-title">暂无{{title}}</view>
    <view class="muted">相关业务发生后，记录会出现在这里。</view>
    <button class="secondary" bindtap="openMine">返回我的</button>
  </view>
  <block wx:elif="{{type !== 'addons'}}">
    <view wx:if="{{items.length}}" class="muted record-count">共 {{changeKind === 'SUBSCRIPTION_EXTENSION' ? renewalTotal : items.length}} 条</view>
    <button
      wx:for="{{items}}"
      wx:key="id"
      class="record-card"
      data-id="{{item.id}}"
      bindtap="openRecord"
    >
      <view class="row between">
        <view class="record-title">{{item.title}}</view>
        <text class="tag">{{item.statusText}}</text>
      </view>
      <view class="muted record-subtitle">{{item.subtitle}}</view>
      <view wx:if="{{type === 'orderchanges' && item.quoteSummary}}" class="muted">客户确认截止 {{item.quoteSummary.expiresAtText}}</view>
      <view class="row between">
        <text wx:if="{{item.amountText}}" class="record-amount">{{item.amountText}}</text>
        <text class="record-link">查看详情 →</text>
      </view>
    </button>
  </block>
  <block wx:if="{{type === 'addons' && !loading && !error}}">
    <view wx:if="{{addonError}}" class="notice addon-alert" role="alert">{{addonError}}<button wx:if="{{!addonPending}}" class="text-button" bindtap="reloadAddon">重新读取</button></view>
    <view wx:if="{{addonNotice}}" class="notice" role="status">{{addonNotice}}</view>
    <view wx:if="{{addonPending}}" class="card addon-result">
      <view class="row between"><view class="section-title">原购买进度</view><text class="tag">{{addonPending.state === 'UNKNOWN' ? '结果待核实' : addonReceipt ? (addonReceiptUnverified ? '原状态待更新' : addonReceipt.purchase.statusText) : '已提交，待回读'}}</text></view>
      <view wx:if="{{addonReceipt}}" class="addon-price">{{addonReceipt.bill.amountText}}</view><view wx:if="{{addonPending.km}}" class="muted">原选 {{addonPending.km}} km · {{addonPending.periodText}}</view><view wx:if="{{addonPending.targetModel}}" class="muted">原选目标：{{addonPending.targetModel.label}}</view><view wx:if="{{addonPending.expiresAtText}}" class="muted small">有效截止 {{addonPending.expiresAtText}}</view>
      <view wx:if="{{addonReceiptUnverified}}" class="notice">原购买状态尚未更新，请查询原账单确认资金事实，不能据缓存判断未付款。</view><view wx:if="{{addonReceipt.purchase.bill}}" class="muted small">原账单 {{addonReceipt.purchase.bill.statusText}} · 实收 {{addonReceipt.purchase.bill.paidAmountText}}</view><view wx:if="{{addonReceipt.purchase.paymentReviewText}}" class="notice">{{addonReceipt.purchase.paymentReviewText}}</view><view wx:if="{{addonReceipt.purchase.paymentFacts.receiptCount > 0}}" class="muted small">累计到账 {{addonReceipt.purchase.paymentFacts.receivedAmountText}} · 已退款 {{addonReceipt.purchase.paymentFacts.refundedAmountText}}</view><view wx:if="{{addonReceipt.purchase.statusMessage}}" class="notice">{{addonReceipt.purchase.statusMessage}}</view>
      <view class="muted small">{{addonPending.state === 'UNKNOWN' ? '请求可能已到达后台。继续核对将沿用原购买内容与编号，不会另建一笔。' : '创建账单不代表支付到账；失效、退款或待核账权益不可使用。'}} </view>
      <button wx:if="{{addonReceipt}}" class="primary" bindtap="openAddonBill" disabled="{{busy}}">查看原账单与支付状态</button>
      <button class="secondary" bindtap="recoverAddon" disabled="{{busy}}" loading="{{busy}}">继续核对原购买</button>
      <button wx:if="{{addonReceipt && addonPending.state === 'COMMITTED'}}" class="text-button" bindtap="startAnotherAddon" disabled="{{busy}}">已核对原账单，另选一笔加购</button>
    </view>
    <block wx:if="{{addonCatalog}}">
      <view class="card addon-context"><view class="section-title">{{addonKind === 'MILEAGE_PACK' ? '当前计费月' : '目标换入车型'}}</view>
        <block wx:if="{{addonKind === 'MILEAGE_PACK'}}"><view class="addon-period">{{addonCatalog.periodText || '当前无可购买的计费月'}}</view><view class="muted small">按主套餐实际起租日划分，非自然月</view></block>
        <block wx:else><view class="label">希望换入的品牌 / 车型</view><picker mode="selector" range="{{addonCatalog.targetModels}}" range-key="label" value="{{addonTargetIndex}}" bindchange="chooseAddonTarget" disabled="{{busy || addonPending || !addonCatalog.eligible}}"><view class="addon-picker">{{addonCatalog.targetModel ? addonCatalog.targetModel.label : '请选择目标车型'}}<text>⌄</text></view></picker><view class="muted small">仅用于选定目标车型，不代表预留车辆</view></block>
        <view wx:if="{{addonCatalog.context}}" class="addon-facts"><view>适用订单<text>{{addonCatalog.orderId}}</text></view><view>有效截止<text>{{addonCatalog.expiresAtText}}</text></view><view wx:if="{{addonKind === 'MILEAGE_PACK'}}">适用车型<text>{{addonCatalog.context.modelName || addonCatalog.context.modelDefinitionId}}</text></view></view>
      </view>
      <view class="section-title addon-section">{{addonKind === 'MILEAGE_PACK' ? '选择本月里程' : '单次换车权益'}}</view>
      <view wx:if="{{addonCatalog.emptyReason}}" class="card addon-empty"><view class="section-title">{{addonCatalog.eligible ? '暂无可选报价' : '当前暂不可购买'}}</view><view class="muted">{{addonCatalog.emptyReason}}</view></view>
      <button wx:for="{{addonCatalog.quotes}}" wx:key="key" class="addon-option" data-key="{{item.key}}" bindtap="selectAddonQuote" disabled="{{busy || addonPending || !addonCatalog.canPurchase}}"><view><view class="addon-option-title">{{addonKind === 'MILEAGE_PACK' ? item.km + ' km' : '换车权益 · 1次'}}</view><view class="muted small">{{addonKind === 'MILEAGE_PACK' ? item.unitPriceText : addonCatalog.targetModel.label}}</view></view><view><view class="addon-price">{{item.amountText}}</view><view class="addon-choice">选择 →</view></view></button>
      <view class="addon-rules"><view class="section-title">购买须知</view><block wx:if="{{addonKind === 'MILEAGE_PACK'}}"><view>仅以上计费月有效；同月换车余额随主订单使用，月末不结转。</view><view>原月待结算的已付月包仅核对原月，不计入当期可用余额。</view></block><block wx:else><view>仅限选定目标车型，价格不含车辆升级差价。</view><view>按购买时当前服务租期有效，实际退订即失效；主套餐赠送次数优先，历史付费权益按原规则保留。</view></block><view>只有后台核实到账后才发放权益。具体资格由后台最终核对。</view></view>
    </block>
    <button class="text-button" bindtap="openAddonHistory">查看已有权益、购买与月结算 →</button>
    <button class="text-button" bindtap="contactUsageService">联系平台核对</button>
  </block>
  <view wx:if="{{type === 'addons' && addonSheet && addonSelected}}" class="addon-mask" catchtap="closeAddonSheet"></view>
  <view wx:if="{{type === 'addons' && addonSheet && addonSelected}}" class="addon-sheet" role="dialog" aria-label="确认本次加购"><view class="row between"><view class="section-title">确认本次加购</view><button class="text-button addon-close" bindtap="closeAddonSheet" disabled="{{busy}}">关闭</button></view><scroll-view scroll-y class="addon-sheet-scroll"><view class="row between"><view class="addon-option-title">{{addonKind === 'MILEAGE_PACK' ? addonSelected.km + ' km' : '换车权益 · 1次'}}</view><view class="addon-price">{{addonSelected.amountText}}</view></view><view class="addon-facts"><view>商品<text>{{addonSelected.name}} · v{{addonSelected.version}}</text></view><view>订单<text>{{addonCatalog.orderId}}</text></view><view wx:if="{{addonKind === 'MILEAGE_PACK'}}">计费月<text>{{addonCatalog.periodText}}</text></view><view wx:else>目标车型<text>{{addonCatalog.targetModel.label}}</text></view><view>有效截止<text>{{addonCatalog.expiresAtText}}</text></view></view><view class="addon-terms-label">完整功能说明 · 版本 {{addonKind === 'MILEAGE_PACK' ? '2' : '1'}}</view><view class="addon-terms">{{addonCatalog.terms.content}}</view><checkbox-group bindchange="onAddonAccepted"><label class="consent-row"><checkbox value="addon" checked="{{addonAccepted}}" disabled="{{busy}}" color="#231815"/><text>我已阅读完整功能说明，核对本次价格、适用范围与期限，同意创建本次账单。</text></label></checkbox-group></scroll-view><button class="primary" bindtap="submitAddon" disabled="{{busy || !addonAccepted}}" loading="{{busy}}">确认创建 {{addonSelected.amountText}} 账单</button><view class="muted small addon-footnote">随后到原账单主动付款，创建不会自动扣款</view></view>
  <view wx:if="{{type === 'orderchanges' && changeKind === 'SUBSCRIPTION_EXTENSION' && !loading && !error}}" class="row renewal-pager"><button class="secondary" bindtap="previousRenewalPage" disabled="{{busy || renewalPage <= 1}}">上一页</button><text>第 {{renewalPage}} 页</text><button class="secondary" bindtap="nextRenewalPage" disabled="{{busy || !renewalHasNext}}">下一页</button></view>
  <block wx:if="{{!loading && !error && type === 'entitlements'}}">
    <view wx:if="{{swapError}}" class="notice" role="alert">{{swapError}}</view><view wx:if="{{swapMessage}}" class="notice" role="status">{{swapMessage}}</view>
    <view wx:if="{{swap}}" class="card">
      <view class="section-title">{{swap.term ? '合同期赠送与本订阅' : offlineSwap ? '本订阅与历史换车记录' : '免费换车次数与本订阅'}}</view><view>{{swap.currentVehicleText}}</view><view class="muted small">订单已记录期限至 {{swap.endDateText}} · 原实际起租 {{swap.startedOnText}}</view>
      <view wx:if="{{offlineSwap}}" class="notice">本单采用纸质补充协议。申请、报价、归档、核款和两车实际交接分别办理；能否新申请或购买，以当前账户核验结果为准。</view>
      <block wx:if="{{swap.term}}"><view class="label">合同期赠送 {{swap.term.includedCount}} 次</view><view>{{swap.term.periodText}}</view><view class="grid-2"><view><view class="label">当前可用</view><view class="price">{{swap.term.available}} 次</view></view><view><view class="label">已预占，未消费</view><view class="price">{{swap.term.reserved}} 次</view></view></view><view class="muted">未消费共 {{swap.term.remaining}} 次（含预占）；已实际消费 {{swap.term.consumed}} 次</view><view class="notice">赠送覆盖本服务期，不按年度清零；续期生效按新期重发，原期免费次数不结转。申请与报价只预占，实际新车交付才消费；换车不重置合同期限、里程月界或里程余额。当前能否办理以本单开放状态为准。</view></block><block wx:elif="{{!offlineSwap}}"><view class="label">第 {{swap.cycle.sequence}} 个12个月周期</view><view>{{swap.cycle.periodText}}</view><view class="grid-2"><view><view class="label">免费可用</view><view class="price">{{swap.cycle.freeAvailable}} 次</view></view><view><view class="label">免费预占</view><view class="price">{{swap.cycle.freeReserved}} 次</view></view></view><view class="muted">本周期已实际消费 {{swap.cycle.freeConsumed}} 次</view><view class="notice">申请、报价只预占，实际换车完成后才消费。以新车实际交付时所属周期优先使用免费次数；未用免费次数不结转。换车不重置原期限、月界、1500公里基础及包余额；付费次数须另行购买并经可信到账，未到账、冻结或已失效次数不可用。</view></block>
      <view wx:for="{{swap.blockers}}" wx:key="index" class="notice">{{item}}</view><view wx:for="{{swap.reservations}}" wx:key="id" class="field"><view>{{item.sourceText}} · {{item.scopeText}} · {{item.statusText}}</view><button class="text-button" data-id="{{item.changeId}}" bindtap="openSwapChange">查看对应换车流程 →</button></view>
      <block wx:if="{{!swapModeMismatch && swap.canRequest}}"><view class="field"><view class="label">换车原因</view><textarea class="textarea" value="{{swapReason}}" bindinput="inputSwapReason" maxlength="500" disabled="{{busy}}" placeholder="请填写真实需求，等待运营联系及逐单报价"/></view><button class="primary" bindtap="requestSwap" disabled="{{busy || !swapReason}}" loading="{{busy}}">提交换车申请</button></block>
      <button class="secondary" bindtap="openAllChanges">查看换车与延期记录</button><view wx:if="{{swap.ledger.length}}" class="section-title">服务端次数流水</view><view wx:for="{{swap.ledger}}" wx:key="id" class="field"><view>{{item.typeText}} · {{item.sourceText}} · {{item.scopeText}}</view><view wx:if="{{item.actualAtText}}" class="muted small">实际发生 {{item.actualAtText}}</view><view class="muted small">登记 {{item.recordedAtText}}</view></view>
    </view>
    <view wx:if="{{swap && (swap.term || !offlineSwap || swap.purchases.length || swap.paidAvailable || swap.paidReserved || swap.paidConsumed || swap.paidFrozen || swap.paidExpired || swapPurchase)}}" class="card">
      <view class="section-title">{{swap.term ? '本订单付费换车次数' : offlineSwap ? '历史付费换车记录' : '本订阅付费换车次数'}}</view><view class="muted small">订单 {{swap.orderId}} · 每笔付费次数按其购买时冻结的有效期，续期不自动延期</view>
      <view class="grid-2"><view><view class="label">付费可用</view><view class="price">{{swap.paidAvailable}} 次</view></view><view><view class="label">付费预占</view><view class="price">{{swap.paidReserved}} 次</view></view></view><view class="muted">已消费 {{swap.paidConsumed}} 次 · 冻结 {{swap.paidFrozen}} 次 · 已失效 {{swap.paidExpired}} 次</view>
      <view wx:if="{{swap.term || !offlineSwap}}" class="notice">{{swap.term ? '合同期赠送次数优先使用，不按年度清零。' : '免费次数按实际完成时所属周期优先使用。'}}购买不代表换车申请或实际换车；到账次数也须逐单方案与两侧真实交接才能消费。不同订单的次数不能转移。</view>
      <view wx:if="{{swapPurchaseError}}" class="notice" role="alert">{{swapPurchaseError}}</view><view wx:if="{{swapPurchaseMessage}}" class="notice" role="status">{{swapPurchaseMessage}}</view>
      <view wx:if="{{swapPurchase}}" class="field"><view class="section-title">本次操作回读</view><view>{{swapPurchase.purchase.amountText}} · {{swapPurchase.purchase.statusText}}</view><view wx:if="{{swapPurchase.purchase.statusMessage}}" class="notice">{{swapPurchase.purchase.statusMessage}}</view><view class="muted small">购买 {{swapPurchase.purchase.id}} · 截止 {{swapPurchase.purchase.expiresOnText}}</view><button class="secondary" data-id="{{swapPurchase.bill.id}}" bindtap="openSwapPurchaseBill" disabled="{{busy}}">查看原普通账单，另行核对付款</button><button class="secondary" data-id="{{swapPurchase.purchase.id}}" bindtap="querySwapPurchase" disabled="{{busy}}">查询原支付与购买状态</button><button wx:if="{{swapPurchase.purchase.canClose}}" class="text-button" data-id="{{swapPurchase.purchase.id}}" bindtap="closeSwapPurchase" disabled="{{busy}}">查询并撤销本次未支付购买</button></view>
      <view class="field"><view class="section-title">目标车型换车权益</view><view class="muted small">新购按希望换入的品牌、车型单独报价，不含升级差价。原赠送、历史付费记录与主套餐约定保留。</view><button class="secondary" data-kind="SWAP_CREDIT" bindtap="openNewAddon">选择目标车型加购</button></view>
      <view wx:if="{{swap.purchases.length}}" class="section-title">本订单购买来源与进度</view>
      <view wx:for="{{swap.purchases}}" wx:key="id" class="field"><view>{{item.amountText}} · 一次 · {{item.statusText}}</view><view class="muted small">购买 {{item.id}} · 截止 {{item.expiresOnText}}</view><view wx:if="{{item.scopeText}}" class="notice">{{item.scopeText}}</view><view class="muted small">普通账单实收 {{item.bill.paidAmountText}} · 购买说明 {{item.terms.version}}</view><view wx:if="{{item.paidAtText}}" class="muted small">到账 {{item.paidAtText}}</view><view wx:if="{{item.reservedChangeId}}" class="notice">本次已预占到换车流程，不能用于另一流程或申请例外退款。<button class="text-button" data-id="{{item.reservedChangeId}}" bindtap="openSwapChange">查看预占的换车流程 →</button></view><button wx:if="{{item.consumedChangeId}}" class="text-button" data-id="{{item.consumedChangeId}}" bindtap="openSwapChange">查看实际消费的换车流程 →</button><view wx:if="{{item.statusMessage}}" class="notice">{{item.statusMessage}}</view><view wx:if="{{item.manualReviewRequired}}" class="notice">本记录需人工核账，不能认定未扣款，也不可使用冻结次数；请查询原记录或联系人工。</view><view wx:for="{{item.refunds}}" wx:for-item="refund" wx:key="id" class="field"><view>退款 {{refund.amountText}} · {{refund.statusText}}</view></view><button class="secondary" data-id="{{item.billId}}" bindtap="openSwapPurchaseBill" disabled="{{busy}}">{{item.canPay ? '核对原普通账单并主动付款' : '查看原普通账单'}}</button><button class="secondary" data-id="{{item.id}}" bindtap="querySwapPurchase" disabled="{{busy}}">查询原支付与购买状态</button><button wx:if="{{item.canClose}}" class="text-button" data-id="{{item.id}}" bindtap="closeSwapPurchase" disabled="{{busy}}">查询并撤销本次未支付购买</button><view wx:if="{{item.canRequestRefund}}" class="muted small">完整未用且未预占的例外退款须联系人工，由另一名财务独立复核；本页不直接退款。</view></view>
    </view>
    <view wx:if="{{usageError}}" class="notice" role="alert">{{usageError}}<button class="text-button" bindtap="reload" disabled="{{busy}}">重新读取月里程与余额</button></view>
    <block wx:if="{{usage}}">
      <view class="card"><view class="section-title">订阅月里程与加购余额</view><view class="muted">实际交车起算 {{usage.startedOnText}} · 基础每订阅月 {{usage.baseAllowanceKm}} km</view><view class="price">当期可用里程包 {{usage.availablePackBalanceKm}} km</view><view>{{usage.packStatusText}}</view><view wx:if="{{usage.packBalanceKm !== usage.availablePackBalanceKm}}" class="muted small">账面保留余额 {{usage.packBalanceKm}} km，含历史或冻结待结算额度，不代表当期可用。</view><view wx:if="{{usage.historicalPendingPackBalanceKm > 0}}" class="notice">原月待结算月包 {{usage.historicalPendingPackBalanceKm}} km，仅核对对应原月，当前不可使用。</view><view class="notice">基础额度优先使用、期末清零。新月包仅原计费月有效、不结转；历史V1按原订阅期结转。待结算的原月余额不计入当期可用；各月均以真实证据结算。</view></view>
      <view class="card"><view class="section-title">各订阅月结算</view><view wx:for="{{usage.periods}}" wx:key="id" class="field"><view>第 {{item.sequence}} 月 · {{item.periodText}}</view><view>{{item.statusText}}</view><view class="muted small">实际使用 {{item.usedKm == null ? '待审核' : item.usedKm}} km · 基础 {{item.baseUsedKm == null ? '待审核' : item.baseUsedKm}} km · 包 {{item.packUsedKm == null ? '待审核' : item.packUsedKm}} km</view><view class="muted small">超里程 {{item.excessKm == null ? '待审核' : item.excessKm}} km · {{item.excessAmountText}}</view><view wx:if="{{item.segmented}}" class="notice">本月按各车段独立核验后汇总，基础额度仅扣一次；缺任一段不能结算，不跨车相减仪表。</view><view wx:for="{{item.segments}}" wx:for-item="segment" wx:key="id" class="field"><view>{{segment.vehicleTitle}} · {{segment.statusText}}</view><view class="muted small">{{segment.startAtText}} — {{segment.endAtText}}</view><view>本车仪表 {{segment.startReadingKm == null ? '待证据' : segment.startReadingKm}} → {{segment.endReadingKm == null ? '待证据' : segment.endReadingKm}} km</view></view><view wx:if="{{item.reviewNote}}" class="notice">{{item.reviewNote}}</view><button wx:if="{{item.canSubmit}}" class="secondary" data-id="{{item.id}}" bindtap="openUsagePeriod">申报本月界读数或补证</button><button wx:if="{{item.billId}}" class="text-button" data-id="{{item.billId}}" bindtap="openUsageBill">查看本月普通账单 →</button></view></view>
      <view wx:if="{{usage.assignments.length}}" class="card"><view class="section-title">本订阅逐车分配记录</view><view wx:for="{{usage.assignments}}" wx:key="id" class="field"><view>{{item.vehicle.title}} · {{item.statusText}}</view><view class="muted small">{{item.vehicle.plateNumber}} · VIN {{item.vehicle.vin}}</view><view class="muted small">交付 {{item.startAtText}} · 交还 {{item.endAtText}}</view><view>本车仪表 {{item.startReadingKm}} → {{item.endReadingKm == null ? '尚待交还' : item.endReadingKm}} km</view></view><view class="notice">每车以自己的仪表与证据核对，分配记录只读；不同车辆读数不能相减，换车不重置本订阅额度。</view></view><view wx:if="{{usageMessage}}" class="notice" role="status">{{usageMessage}}</view>
      <view wx:if="{{purchaseError}}" class="notice" role="alert">{{purchaseError}}</view>
      <view wx:if="{{purchase}}" class="card"><view class="section-title">本次里程包账单</view><view>{{purchase.purchase.km}} km · {{purchase.bill.amountText}}</view><view>{{purchase.purchase.statusText}}</view><view class="notice">创建账单不会发放额度。只有服务端核实支付到账后，刷新余额才能看到已发放里程。</view><button class="primary" bindtap="openPurchaseBill" disabled="{{busy}}">到普通账单详情核对与付款</button></view>
      <view class="card"><view class="section-title">加购里程包</view><view class="muted">新里程包按当前车型独立报价，仅购买时计费月有效；旧余额继续保留原规则。</view><button class="secondary" data-kind="MILEAGE_PACK" bindtap="openNewAddon">选择本月里程包</button></view>
      <view wx:if="{{usage.packs.length}}" class="card"><view class="section-title">已创建的里程包</view><view wx:for="{{usage.packs}}" wx:key="id" class="field"><view>{{item.km}} km · {{item.amountText}} · {{item.statusText}}</view><view class="muted small">账面剩余额度 {{item.remainingKm}} km · {{item.ruleVersion === 'MILEAGE_PACK_V2' ? '当月包' : '历史包'}}</view><view class="muted small">{{item.ruleText}}</view><view wx:if="{{item.periodId}}" class="muted small">适用计费月 {{item.periodId}} · 截止 {{item.expiresAtText}}</view><view wx:if="{{item.bill}}" class="muted small">原账单 {{item.bill.statusText}} · 实收 {{item.bill.paidAmountText}}</view><view wx:if="{{item.paymentReviewText}}" class="notice">{{item.paymentReviewText}}</view><view wx:if="{{item.paymentFacts.receiptCount > 0}}" class="muted small">累计到账 {{item.paymentFacts.receivedAmountText}} · 已退款 {{item.paymentFacts.refundedAmountText}}</view><view wx:if="{{item.availabilityText}}" class="notice">{{item.availabilityText}}</view><button wx:if="{{item.billId}}" class="text-button" data-id="{{item.billId}}" bindtap="openUsageBill">查看对应普通账单 →</button></view></view>
      <view wx:if="{{usage.ledger.length}}" class="card"><view class="section-title">服务端额度流水</view><view wx:for="{{usage.ledger}}" wx:key="id" class="field"><view>{{item.typeText}} · {{item.deltaKm}} km</view><view class="muted small">{{item.createdAt}}</view></view></view>
      <view wx:if="{{settlementError}}" class="notice">{{settlementError}}<button class="text-button" bindtap="reload" disabled="{{busy}}">刷新结算</button></view>
      <view wx:if="{{settlement}}" class="card"><view class="section-title">归还与退订结算</view><view>{{settlement.statusText}}</view><view class="muted">实际归还日 {{settlement.returnedOnText}}</view><view wx:if="{{settlement.unsettledPeriodIds.length}}" class="notice">仍有 {{settlement.unsettledPeriodIds.length}} 个订阅月未完成结算，需补充证据或等待人工审核；不能认定已结清。</view><view wx:if="{{settlement.depositRefundRequiredAmount > 0}}" class="notice">押金仍待退还 {{settlement.depositRefundRequiredText}}，由财务独立复核处理；本页不自动退款或扣押金。</view><view wx:for="{{settlement.bills}}" wx:key="id" class="field"><view>{{item.typeText}} · {{item.amountText}} · {{item.statusText}}</view><view class="muted small">{{item.description}}</view><button class="text-button" data-id="{{item.id}}" bindtap="openUsageBill">查看结算普通账单 →</button></view><view wx:if="{{settlement.disputeReason}}" class="notice">异议：{{settlement.disputeReason}}</view><view wx:if="{{settlement.resolutionNote}}" class="muted">人工处理说明：{{settlement.resolutionNote}}</view><block wx:if="{{settlement.canDispute}}"><view class="field"><view class="label">需要人工核对的结算异议</view><textarea class="textarea" value="{{disputeReason}}" bindinput="inputDispute" maxlength="500" disabled="{{busy}}"/></view><button class="secondary" bindtap="disputeSettlement" disabled="{{busy}}">提交异议，转人工处理</button></block><view class="notice">结算依据已确认的还车交接与真实里程证据。本页不会直接结束订阅、自动扣押金或替你确认结清。</view></view>
    </block>
    <button class="secondary" bindtap="contactUsageService" disabled="{{busy}}">联系人工核对权益与结算</button><button class="text-button" bindtap="reload" disabled="{{busy}}">刷新可信到账、月台账与结算</button>
  </block>
</view>
