<view class="page">
  
  <view class="eyebrow">YOUR RECORDS / 记录</view>
  <view class="title">{{title}}</view>
  <view wx:if="{{loading}}" class="empty">正在读取记录…</view>
  <view wx:elif="{{error}}" class="empty">
    <view>{{error}}</view>
    <button class="secondary" bindtap="reload">重新加载</button>
    <button class="text-button" bindtap="openMine">返回我的</button>
  </view>
  <view wx:elif="{{!items.length && !(type === 'entitlements' && (usage || swap))}}" class="empty">
    <view class="section-title">暂无{{title}}</view>
    <view class="muted">相关业务发生后，记录会出现在这里。</view>
    <button class="secondary" bindtap="openMine">返回我的</button>
  </view>
  <block wx:else>
    <view wx:if="{{items.length}}" class="muted record-count">共 {{items.length}} 条</view>
    <button
      wx:for="{{items}}"
      wx:key="id"
      class="record-card"
      data-id="{{item.id}}"
      bindtap="openRecord"
    >
      <view class="row between">
        <view class="record-title">{{item.title}}</view>
        <text class="tag">{{item.statusText}}</text>
      </view>
      <view class="muted record-subtitle">{{item.subtitle}}</view>
      <view wx:if="{{type === 'orderchanges' && item.quoteSummary}}" class="muted">客户确认截止 {{item.quoteSummary.expiresAtText}}</view>
      <view class="row between">
        <text wx:if="{{item.amountText}}" class="record-amount">{{item.amountText}}</text>
        <text class="record-link">查看详情 →</text>
      </view>
    </button>
  </block>
  <block wx:if="{{!loading && !error && type === 'entitlements'}}">
    <view wx:if="{{swapError}}" class="notice" role="alert">{{swapError}}</view><view wx:if="{{swapMessage}}" class="notice" role="status">{{swapMessage}}</view><view wx:if="{{swap}}" class="card"><view class="section-title">免费换车次数与本订阅</view><view>{{swap.currentVehicleText}}</view><view class="muted small">原订阅期限至 {{swap.endDateText}} · 实际起租 {{swap.startedOnText}}</view><view class="label">第 {{swap.cycle.sequence}} 个12个月周期</view><view>{{swap.cycle.periodText}}</view><view class="grid-2"><view><view class="label">免费可用</view><view class="price">{{swap.cycle.freeAvailable}} 次</view></view><view><view class="label">免费预占</view><view class="price">{{swap.cycle.freeReserved}} 次</view></view></view><view class="muted">本周期已实际消费 {{swap.cycle.freeConsumed}} 次</view><view class="notice">申请、报价只预占，实际换车完成后才消费。以新车实际交付时所属周期优先使用免费次数；未用免费次数不结转。换车不重置原期限、月界、1500公里基础及包余额；付费次数须另行购买并经可信到账，未到账、冻结或已失效次数不可用。</view><view wx:for="{{swap.blockers}}" wx:key="index" class="notice">{{item}}</view><view wx:for="{{swap.reservations}}" wx:key="id" class="field"><view>{{item.sourceText}} {{item.cycleSequence == null ? '· 本订阅付费来源' : '· 第 ' + item.cycleSequence + ' 周期'}} · {{item.statusText}}</view><button class="text-button" data-id="{{item.changeId}}" bindtap="openSwapChange">查看对应换车流程 →</button></view><block wx:if="{{swap.canRequest}}"><view class="field"><view class="label">换车原因</view><textarea class="textarea" value="{{swapReason}}" bindinput="inputSwapReason" maxlength="500" disabled="{{busy}}" placeholder="请填写真实需求，等待运营联系及逐单报价"/></view><button class="primary" bindtap="requestSwap" disabled="{{busy || !swapReason}}" loading="{{busy}}">提交换车申请</button></block><button class="secondary" bindtap="openAllChanges">查看换车与延期记录</button><view wx:if="{{swap.ledger.length}}" class="section-title">服务端次数流水</view><view wx:for="{{swap.ledger}}" wx:key="id" class="field"><view>{{item.typeText}} · {{item.sourceText}} {{item.cycleSequence == null ? '· 本订阅付费来源' : '· 第 ' + item.cycleSequence + ' 周期'}}</view><view wx:if="{{item.actualAtText}}" class="muted small">实际发生 {{item.actualAtText}}</view><view class="muted small">登记 {{item.recordedAtText}}</view></view></view>
    <view wx:if="{{swap}}" class="card">
      <view class="section-title">本订阅付费换车次数</view><view class="muted small">订单 {{swap.orderId}} · 仅本订阅期有效，截止 {{swap.endDateText}}</view>
      <view class="grid-2"><view><view class="label">付费可用</view><view class="price">{{swap.paidAvailable}} 次</view></view><view><view class="label">付费预占</view><view class="price">{{swap.paidReserved}} 次</view></view></view><view class="muted">已消费 {{swap.paidConsumed}} 次 · 冻结 {{swap.paidFrozen}} 次 · 已失效 {{swap.paidExpired}} 次</view>
      <view class="notice">免费次数按实际完成时所属周期优先使用。购买不代表换车申请或实际换车；到账次数也须逐单方案与两侧真实交接才能消费。不同订单的次数不能转移。</view>
      <view wx:if="{{swapPurchaseError}}" class="notice" role="alert">{{swapPurchaseError}}</view><view wx:if="{{swapPurchaseMessage}}" class="notice" role="status">{{swapPurchaseMessage}}</view>
      <view wx:if="{{swapPurchase}}" class="field"><view class="section-title">本次操作回读</view><view>{{swapPurchase.purchase.amountText}} · {{swapPurchase.purchase.statusText}}</view><view wx:if="{{swapPurchase.purchase.statusMessage}}" class="notice">{{swapPurchase.purchase.statusMessage}}</view><view class="muted small">购买 {{swapPurchase.purchase.id}} · 截止 {{swapPurchase.purchase.expiresOnText}}</view><button class="secondary" data-id="{{swapPurchase.bill.id}}" bindtap="openSwapPurchaseBill" disabled="{{busy}}">查看原普通账单，另行核对付款</button><button class="secondary" data-id="{{swapPurchase.purchase.id}}" bindtap="querySwapPurchase" disabled="{{busy}}">查询原支付与购买状态</button><button wx:if="{{swapPurchase.purchase.canClose}}" class="text-button" data-id="{{swapPurchase.purchase.id}}" bindtap="closeSwapPurchase" disabled="{{busy}}">查询并撤销本次未支付购买</button></view>
      <view wx:if="{{!swap.purchaseTerms}}" class="notice">正式换车购买说明尚未发布或暂不可用，不能创建新账单；已有购买仍可查询。</view>
      <block wx:else><view class="section-title">固定800元 · 本订单一次换车权益</view><view class="muted small">购买说明版本 {{swap.purchaseTerms.documentVersion}}</view><view class="swap-terms">{{swap.purchaseTerms.content}}</view><view class="notice">仅本订阅期有效，可分别多笔叠加；退订或到期剩余次数失效，未使用费用不退。例外履约、争议或依法退款须联系人工独立核对，不自动退款或扣押金。</view><block wx:if="{{swap.canPurchase}}"><checkbox-group bindchange="onSwapPurchaseAccepted"><label class="consent-row"><checkbox value="swap-purchase" checked="{{swapPurchaseAccepted}}" disabled="{{busy}}" color="#252723"/><text>我已完整阅读本版本购买说明，核对本订单、固定800元一次及截止日期，同意本次购买。一般登录同意不代替本次选择；创建账单后仍须另行主动付款。</text></label></checkbox-group><button class="primary" bindtap="buySwapCredit" disabled="{{busy || !swapPurchaseAccepted}}" loading="{{busy}}">创建800元一次普通账单</button></block><view wx:else class="notice">当前暂不能购买新次数，已有记录与可信支付仍可核对。</view></block>
      <view wx:for="{{swap.purchaseBlockers}}" wx:key="index" class="notice">{{item}}</view>
      <view wx:if="{{swap.purchases.length}}" class="section-title">本订单购买来源与进度</view>
      <view wx:for="{{swap.purchases}}" wx:key="id" class="field"><view>{{item.amountText}} · 一次 · {{item.statusText}}</view><view class="muted small">购买 {{item.id}} · 截止 {{item.expiresOnText}}</view><view class="muted small">普通账单实收 {{item.bill.paidAmountText}} · 购买说明 v{{item.terms.documentVersion}}</view><view wx:if="{{item.paidAtText}}" class="muted small">到账 {{item.paidAtText}}</view><view wx:if="{{item.reservedChangeId}}" class="notice">本次已预占到换车流程，不能用于另一流程或申请例外退款。<button class="text-button" data-id="{{item.reservedChangeId}}" bindtap="openSwapChange">查看预占的换车流程 →</button></view><button wx:if="{{item.consumedChangeId}}" class="text-button" data-id="{{item.consumedChangeId}}" bindtap="openSwapChange">查看实际消费的换车流程 →</button><view wx:if="{{item.statusMessage}}" class="notice">{{item.statusMessage}}</view><view wx:if="{{item.manualReviewRequired}}" class="notice">本记录需人工核账，不能认定未扣款，也不可使用冻结次数；请查询原记录或联系人工。</view><view wx:for="{{item.refunds}}" wx:for-item="refund" wx:key="id" class="field"><view>退款 {{refund.amountText}} · {{refund.statusText}}</view></view><button class="secondary" data-id="{{item.billId}}" bindtap="openSwapPurchaseBill" disabled="{{busy}}">{{item.canPay ? '核对原普通账单并主动付款' : '查看原普通账单'}}</button><button class="secondary" data-id="{{item.id}}" bindtap="querySwapPurchase" disabled="{{busy}}">查询原支付与购买状态</button><button wx:if="{{item.canClose}}" class="text-button" data-id="{{item.id}}" bindtap="closeSwapPurchase" disabled="{{busy}}">查询并撤销本次未支付购买</button><view wx:if="{{item.canRequestRefund}}" class="muted small">完整未用且未预占的例外退款须联系人工，由另一名财务独立复核；本页不直接退款。</view></view>
    </view>
    <view wx:if="{{usageError}}" class="notice" role="alert">{{usageError}}<button class="text-button" bindtap="reload" disabled="{{busy}}">重新读取月里程与余额</button></view>
    <block wx:if="{{usage}}">
      <view class="card"><view class="section-title">订阅月里程与加购余额</view><view class="muted">实际交车起算 {{usage.startedOnText}} · 基础每订阅月 {{usage.baseAllowanceKm}} km</view><view class="price">里程包余额 {{usage.packBalanceKm}} km</view><view>{{usage.packStatusText}}</view><view class="notice">基础额度优先使用，期末清零；包余额仅在本订阅期结转。中途退订当月仍有完整1500公里基础额度；未结算月份需真实月界或归还证据，不跨月估算。</view></view>
      <view class="card"><view class="section-title">各订阅月结算</view><view wx:for="{{usage.periods}}" wx:key="id" class="field"><view>第 {{item.sequence}} 月 · {{item.periodText}}</view><view>{{item.statusText}}</view><view class="muted small">实际使用 {{item.usedKm == null ? '待审核' : item.usedKm}} km · 基础 {{item.baseUsedKm == null ? '待审核' : item.baseUsedKm}} km · 包 {{item.packUsedKm == null ? '待审核' : item.packUsedKm}} km</view><view class="muted small">超里程 {{item.excessKm == null ? '待审核' : item.excessKm}} km · {{item.excessAmountText}}</view><view wx:if="{{item.segmented}}" class="notice">本月按各车段独立核验后汇总，基础额度仅扣一次；缺任一段不能结算，不跨车相减仪表。</view><view wx:for="{{item.segments}}" wx:for-item="segment" wx:key="id" class="field"><view>{{segment.vehicleTitle}} · {{segment.statusText}}</view><view class="muted small">{{segment.startAtText}} — {{segment.endAtText}}</view><view>本车仪表 {{segment.startReadingKm == null ? '待证据' : segment.startReadingKm}} → {{segment.endReadingKm == null ? '待证据' : segment.endReadingKm}} km</view></view><view wx:if="{{item.reviewNote}}" class="notice">{{item.reviewNote}}</view><button wx:if="{{item.canSubmit}}" class="secondary" data-id="{{item.id}}" bindtap="openUsagePeriod">申报本月界读数或补证</button><button wx:if="{{item.billId}}" class="text-button" data-id="{{item.billId}}" bindtap="openUsageBill">查看本月普通账单 →</button></view></view>
      <view wx:if="{{usage.assignments.length}}" class="card"><view class="section-title">本订阅逐车分配记录</view><view wx:for="{{usage.assignments}}" wx:key="id" class="field"><view>{{item.vehicle.title}} · {{item.statusText}}</view><view class="muted small">{{item.vehicle.plateNumber}} · VIN {{item.vehicle.vin}}</view><view class="muted small">交付 {{item.startAtText}} · 交还 {{item.endAtText}}</view><view>本车仪表 {{item.startReadingKm}} → {{item.endReadingKm == null ? '尚待交还' : item.endReadingKm}} km</view></view><view class="notice">每车以自己的仪表与证据核对，分配记录只读；不同车辆读数不能相减，换车不重置本订阅额度。</view></view><view wx:if="{{usageMessage}}" class="notice" role="status">{{usageMessage}}</view>
      <view wx:if="{{purchaseError}}" class="notice" role="alert">{{purchaseError}}</view>
      <view wx:if="{{purchase}}" class="card"><view class="section-title">本次里程包账单</view><view>{{purchase.purchase.km}} km · {{purchase.bill.amountText}}</view><view>{{purchase.purchase.statusText}}</view><view class="notice">创建账单不会发放额度。只有服务端核实支付到账后，刷新余额才能看到已发放里程。</view><button class="primary" bindtap="openPurchaseBill" disabled="{{busy}}">到普通账单详情核对与付款</button></view>
      <view class="card"><view class="section-title">加购里程包</view><view wx:if="{{!usage.purchaseTerms}}" class="notice">正式里程包购买协议尚未发布或暂不可用，不能创建购买账单。历史余额与月台账仍可查看。</view><block wx:else><button class="text-button" bindtap="openPackTerms">查看完整里程包购买规则 · 版本 {{usage.purchaseTerms.documentVersion}} →</button><view class="notice">仅当前订阅期有效，可叠加并逐月结转；可抵当月尚未结算的超里程，已结算月份不追溯。退订时剩余额度失效，不退未使用费用；异常履约或争议请联系人工。</view><view class="muted small">{{usage.purchaseTerms.content}}</view><radio-group bindchange="selectMileageProduct"><view wx:for="{{usage.products}}" wx:key="id" class="field"><label class="row"><radio value="{{item.id}}" checked="{{selectedProductId === item.id}}" disabled="{{busy || !usage.canPurchase}}" color="#B44919"/><text>{{item.km}} km · {{item.amountText}}</text></label></view></radio-group><block wx:if="{{usage.canPurchase}}"><view wx:if="{{selectedProduct}}" class="price">{{selectedProduct.km}} km · {{selectedProduct.amountText}}</view><checkbox-group bindchange="onPurchaseAccepted"><label class="consent-row"><checkbox value="purchase" checked="{{purchaseAccepted}}" disabled="{{busy}}" color="#B44919"/><text>我已阅读当前完整购买规则，确认所选金额及仅本订阅期有效、退订失效且不退未使用费用；同意创建本次普通账单。</text></label></checkbox-group><button class="primary" bindtap="buyMileagePack" disabled="{{busy || !selectedProduct || !purchaseAccepted}}" loading="{{busy}}">创建所选里程包账单</button></block><view wx:else class="notice">当前订阅状态不能加购；冻结余额只用于归还前尚未结算月份，不能继续使用。</view></block></view>
      <view wx:if="{{usage.packs.length}}" class="card"><view class="section-title">已创建的里程包</view><view wx:for="{{usage.packs}}" wx:key="id" class="field"><view>{{item.km}} km · {{item.amountText}} · {{item.statusText}}</view><view class="muted small">账面剩余额度 {{item.remainingKm}} km</view><view wx:if="{{item.availabilityText}}" class="notice">{{item.availabilityText}}</view><button wx:if="{{item.billId}}" class="text-button" data-id="{{item.billId}}" bindtap="openUsageBill">查看对应普通账单 →</button></view></view>
      <view wx:if="{{usage.ledger.length}}" class="card"><view class="section-title">服务端额度流水</view><view wx:for="{{usage.ledger}}" wx:key="id" class="field"><view>{{item.typeText}} · {{item.deltaKm}} km</view><view class="muted small">{{item.createdAt}}</view></view></view>
      <view wx:if="{{settlementError}}" class="notice">{{settlementError}}<button class="text-button" bindtap="reload" disabled="{{busy}}">刷新结算</button></view>
      <view wx:if="{{settlement}}" class="card"><view class="section-title">归还与退订结算</view><view>{{settlement.statusText}}</view><view class="muted">实际归还日 {{settlement.returnedOnText}}</view><view wx:if="{{settlement.unsettledPeriodIds.length}}" class="notice">仍有 {{settlement.unsettledPeriodIds.length}} 个订阅月未完成结算，需补充证据或等待人工审核；不能认定已结清。</view><view wx:if="{{settlement.depositRefundRequiredAmount > 0}}" class="notice">押金仍待退还 {{settlement.depositRefundRequiredText}}，由财务独立复核处理；本页不自动退款或扣押金。</view><view wx:for="{{settlement.bills}}" wx:key="id" class="field"><view>{{item.typeText}} · {{item.amountText}} · {{item.statusText}}</view><view class="muted small">{{item.description}}</view><button class="text-button" data-id="{{item.id}}" bindtap="openUsageBill">查看结算普通账单 →</button></view><view wx:if="{{settlement.disputeReason}}" class="notice">异议：{{settlement.disputeReason}}</view><view wx:if="{{settlement.resolutionNote}}" class="muted">人工处理说明：{{settlement.resolutionNote}}</view><block wx:if="{{settlement.canDispute}}"><view class="field"><view class="label">需要人工核对的结算异议</view><textarea class="textarea" value="{{disputeReason}}" bindinput="inputDispute" maxlength="500" disabled="{{busy}}"/></view><button class="secondary" bindtap="disputeSettlement" disabled="{{busy}}">提交异议，转人工处理</button></block><view class="notice">结算依据已确认的还车交接与真实里程证据。本页不会直接结束订阅、自动扣押金或替你确认结清。</view></view>
    </block>
    <button class="secondary" bindtap="contactUsageService" disabled="{{busy}}">联系人工核对权益与结算</button><button class="text-button" bindtap="reload" disabled="{{busy}}">刷新可信到账、月台账与结算</button>
  </block>
</view>
