<view class="page bottom-space offline-order">
 <view wx:if="{{loading}}" class="empty">正在读取订单…</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button class="secondary" bindtap="reload">重新读取</button><button wx:if="{{authRequired}}" class="primary" bindtap="openLogin">重新登录</button></view>
 <block wx:elif="{{order}}"><view class="eyebrow">我的订阅订单</view><view class="title">{{order.statusText}}</view><view class="notice">{{order.nextLabel}}</view><view class="card"><view class="section-title">{{order.title}}</view><view wx:for="{{summaryRows}}" wx:key="label" class="summary-row"><text class="muted">{{item.label}}</text><text>{{item.value}}</text></view><view wx:for="{{order.parties}}" wx:key="role" class="summary-row"><text class="muted">{{item.label}}</text><text>{{item.name || '待核对'}}</text></view></view>
 <view class="card"><view class="section-title">合同资料</view><view class="muted small">线下签署后，由平台上传并独立审核。资料归档后，可查看或反馈疑问。</view><view wx:if="{{!order.archives.length}}" class="notice">合同正在准备，请联系平台安排线下签署。</view><view wx:for="{{order.archives}}" wx:key="id" class="offline-row"><view class="row between"><text>{{item.title}}</text><text class="tag">{{item.statusText}}</text></view><button wx:if="{{item.canRead}}" class="secondary" data-id="{{item.id}}" bindtap="openArchive">查看资料 / 反馈</button></view></view>
 <view class="card"><view class="section-title">账单支付</view><view wx:if="{{order.hasPendingBills && !order.canPay}}" class="notice">当前付款条件尚未齐备，请以订单提示为准。</view><view wx:if="{{!order.bills.length}}" class="muted">暂无账单。</view><view wx:for="{{order.bills}}" wx:key="id" class="offline-row"><view class="section-title">{{item.reasonText}}</view><view wx:if="{{item.description}}" class="muted small">{{item.description}}</view><view wx:if="{{item.periodText}}" class="muted small">{{item.periodText}}</view><view class="row between"><text>付款日 {{item.dueDateText}}</text><text>{{item.statusText}}</text></view><view class="row between"><text class="price">{{item.amountText}}</text><button wx:if="{{item.canPay}}" class="primary compact-action" data-id="{{item.id}}" bindtap="pay" loading="{{busy}}" disabled="{{busy}}">支付</button></view></view></view>
 <view class="card"><view class="section-title">车辆查验与交还</view><view class="muted small">按每份交接记录展示的确认方式办理；实际完成以平台核对为准。</view><view wx:if="{{!order.handovers.length}}" class="muted">暂无查验记录。</view><button wx:for="{{order.handovers}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="openHandover">{{item.title}} · {{item.statusText}}</button></view>
 <view class="card"><view class="section-title">车辆保障</view><view>{{insurance.coverage.statusText}}</view><view wx:for="{{insurance.coverage.blockers}}" wx:key="code" class="muted small">{{item.label}}</view><view wx:if="{{!insurance.policies.length}}" class="muted">保单资料待平台核对。</view><view wx:for="{{insurance.policies}}" wx:key="versionId" class="offline-row"><view>{{item.insurer}} · {{item.statusText}}</view><view class="muted small">保单尾号 {{item.policyNumberLast4}}</view><view class="muted small">{{item.startText}} 至 {{item.endText}}</view><view>{{item.coverageText}}</view></view></view>
 <view class="card"><view class="section-title">订阅权益</view><view wx:if="{{!entitlements.length}}" class="muted">本单暂无单独列明的服务权益。</view><view wx:for="{{entitlements}}" wx:key="id" class="offline-row"><view class="row between"><text>{{item.title}}</text><text class="tag">{{item.statusText}}</text></view><view class="muted small">{{item.description}}</view><view wx:if="{{item.kind === 'COUNT'}}">可用 {{item.availableQuantity}} / 共 {{item.totalQuantity}} {{item.unit}}<text class="muted small"> · 预占 {{item.reservedQuantity}} · 已使用 {{item.consumedQuantity}}</text></view><button wx:if="{{item.canRequest}}" class="secondary" data-id="{{item.id}}" bindtap="requestBenefit">申请服务</button></view></view>
 <button class="secondary" bindtap="reload" disabled="{{busy}}">刷新订单</button><button class="text-button" bindtap="openOrders">全部订单</button></block>
</view>
<view wx:if="{{archiveOpen}}" class="archive-mask" catchtap="stop"><scroll-view scroll-y class="archive-panel"><view class="archive-header"><view class="section-title">{{archive.title || '合同资料'}}</view><button class="text-button" bindtap="closeArchive">关闭</button></view><view wx:if="{{archiveError}}" class="notice">{{archiveError}}</view><view wx:if="{{archiveBusy && !archive}}" class="empty">正在读取…</view><block wx:if="{{archive}}"><picker range="{{versionLabels}}" value="{{versionIndex}}" bindchange="selectVersion" disabled="{{archiveBusy}}"><view class="secondary version-picker">{{versionLabels[versionIndex] || '暂无归档版本'}} ▾</view></picker><block wx:if="{{archive.selectedVersion}}"><view class="muted small">签署日期 {{archive.selectedVersion.signedOnText}}</view><view class="muted small">编号 {{archive.selectedVersion.contractNumber}}</view><view wx:if="{{archive.selectedVersion.status === 'INVALIDATED'}}" class="notice">这是已失效的历史版本，请以平台确认的当前资料为准。</view><button wx:for="{{archive.selectedVersion.files}}" wx:key="id" class="secondary file-button" data-id="{{item.id}}" bindtap="openFile" disabled="{{archiveBusy}}">查看 {{item.position}}. {{item.name}}</button><view class="field"><view class="label">资料有疑问</view><textarea class="textarea" value="{{feedback}}" bindinput="inputFeedback" maxlength="1000" placeholder="请说明页码及需要核对的内容" disabled="{{archiveBusy}}"/></view><view class="muted small">本次反馈关联第 {{archive.selectedVersion.version}} 版资料。</view><button class="primary" bindtap="submitFeedback" disabled="{{archiveBusy || !feedback}}" loading="{{archiveBusy}}">提交问题</button><view wx:if="{{feedbackNote}}" class="notice">{{feedbackNote}}</view></block><view wx:else class="empty">暂无可读取的已归档资料。</view></block></scroll-view></view>
