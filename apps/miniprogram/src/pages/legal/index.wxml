<view class="page"><view class="eyebrow">READ BEFORE YOU GO / 协议</view><view class="title">{{title}}</view>
<view wx:if="{{loading}}" class="empty">正在读取已发布协议…</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button class="secondary" bindtap="reload">重试</button></view>
<block wx:else><view class="legal-intro">{{intro}}</view><view wx:for="{{sections}}" wx:key="title" class="legal-section"><view class="section-title">{{item.title}}</view><view class="legal-body">{{item.text}}</view></view></block>
<button class="secondary" bindtap="openSettings">账户设置</button></view>
