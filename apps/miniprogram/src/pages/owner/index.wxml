<view class="page bottom-space owner-page">
 <view class="eyebrow">企业车主 / 电子签署</view><view class="title">企业签约办理</view><view class="muted">晓浪提供电子签接入。实际企业车主使用自己的认证身份与印章，与订阅客户签署合同。</view>
 <view wx:if="{{loading}}" class="notice">正在读取…</view><view wx:if="{{error}}" class="notice" role="alert">{{error}}</view><view wx:if="{{message}}" class="notice" role="status">{{message}}</view><button class="secondary" bindtap="reload" disabled="{{busy}}">读取最新记录</button><button class="text-button" bindtap="openSettings">账户设置与协议 →</button>
 <view class="card"><view class="section-title">接受企业邀请</view><input placeholder="运营提供的本人邀请编号" value="{{token}}" data-field="token" bindinput="input" disabled="{{busy}}"/><view class="muted">请使用受邀手机号登录。邀请只关联企业，不代表获得签章授权。</view><button class="secondary" bindtap="claim" disabled="{{busy || !token}}">接受本人邀请</button><button wx:for="{{owners}}" wx:key="ownerId" class="text-button" data-id="{{item.ownerId}}" bindtap="select" disabled="{{busy}}">{{item.name}} →</button></view>
 <block wx:if="{{owner}}"><view class="card"><view class="section-title">{{owner.name}}</view><view>{{owner.creditCode}}</view><view>{{owner.address}}</view><view>{{owner.contactPhone}}</view><view class="notice">{{owner.statusText}} · {{owner.readyForSigning ? '身份、证书和选用印章已就绪' : '尚待核验或选用印章'}}</view><view class="muted">企业认证由有权代表企业的经办人本人办理。生成印章不等于同意自动签署。</view><button class="text-button" data-type="owner-identity" bindtap="openLegal">企业身份与电子签接入说明 →</button><button class="text-button" data-type="terms" bindtap="openLegal">用户协议 →</button><button class="text-button" data-type="privacy" bindtap="openLegal">隐私政策 →</button><block wx:if="{{owner.realNameStatus !== 'VERIFIED'}}"><checkbox-group data-field="identityAccepted" bindchange="accepted"><label><checkbox value="yes" checked="{{identityAccepted}}" disabled="{{busy}}"/><text>我已阅读上述三份文本，确认有权代表本企业办理，并单独同意本次向法大大提供企业及经办人认证资料。</text></label></checkbox-group><button class="primary" bindtap="verify" disabled="{{busy || !identityAccepted}}">由本人办理企业实名认证</button></block><button class="secondary" bindtap="refreshIdentity" disabled="{{busy}}">主动核验企业、证书及印章</button></view>
 <view wx:if="{{seals.length}}" class="card"><view class="section-title">核对并选用本企业印章</view><view wx:for="{{seals}}" wx:key="id"><image class="seal" src="{{item.src}}" mode="aspectFit"/><view>{{item.status === 'ACTIVE' ? '当前选用印章' : '待核对印章'}}</view><button class="secondary" data-id="{{item.id}}" bindtap="chooseSeal" disabled="{{busy}}">核对后选用该章</button></view></view>
 <view wx:if="{{options}}" class="card"><view class="section-title">自动授权范围</view><view class="notice">自动签署默认关闭。可继续逐份手动签署；补充协议不在本授权范围内。</view><view wx:if="{{options.template}}">合同模板：{{options.template.title}} · 版本 {{options.template.version}}</view><view class="small muted">模板摘要 {{options.template.hash}}</view><checkbox-group bindchange="vehicles"><label wx:for="{{options.vehicles}}" wx:key="vehicleId"><checkbox value="{{item.vehicleId}}" disabled="{{busy}}"/><text>{{item.vehicle.title}}</text></label></checkbox-group><view wx:if="{{!options.vehicles.length}}" class="notice">尚无已审核归属的车辆，请联系运营。</view><input placeholder="授权开始日 YYYY-MM-DD" value="{{scope.validFrom}}" data-field="validFrom" bindinput="input" disabled="{{busy}}"/><input placeholder="授权截止日 YYYY-MM-DD（当日23:59:59）" value="{{scope.validUntil}}" data-field="validUntil" bindinput="input" disabled="{{busy}}"/><input placeholder="月租最低金额（元）" value="{{scope.minMonthlyFee}}" data-field="minMonthlyFee" bindinput="input" disabled="{{busy}}"/><input placeholder="月租最高金额（元）" value="{{scope.maxMonthlyFee}}" data-field="maxMonthlyFee" bindinput="input" disabled="{{busy}}"/><input placeholder="押金最低金额（元）" value="{{scope.minDeposit}}" data-field="minDeposit" bindinput="input" disabled="{{busy}}"/><input placeholder="押金最高金额（元）" value="{{scope.maxDeposit}}" data-field="maxDeposit" bindinput="input" disabled="{{busy}}"/><input placeholder="订阅最少月数" value="{{scope.minMonths}}" data-field="minMonths" bindinput="input" disabled="{{busy}}"/><input placeholder="订阅最多月数（不超过60）" value="{{scope.maxMonths}}" data-field="maxMonths" bindinput="input" disabled="{{busy}}"/><button class="text-button" data-type="owner-auto-sign" bindtap="openLegal">企业自动签署授权说明 →</button><checkbox-group data-field="autoAccepted" bindchange="accepted"><label><checkbox value="yes" checked="{{autoAccepted}}" disabled="{{busy}}"/><text>我已阅读自动签署说明、用户协议及隐私政策，确认本企业及所选印章，并单独同意按上述车辆、模板、期限和金额范围办理授权。</text></label></checkbox-group><button class="primary" bindtap="authorize" disabled="{{busy || !autoAccepted || !owner.readyForSigning}}">由本人到法大大办理授权</button></view>
 <view wx:for="{{authorities}}" wx:key="id" class="card"><view class="section-title">{{item.enabled ? '自动签署已开启' : '自动签署已关闭'}}</view><view>{{item.statusText}}</view><view class="small">车辆：{{item.scope.vehicleIds}}</view><view>模板版本 {{item.scope.templateVersion}}；{{item.scope.minMonths}}—{{item.scope.maxMonths}}个月</view><view class="small">{{item.scope.validFrom}} 至 {{item.scope.validUntil}}</view><view>月租 {{item.scope.minMonthlyFeeAmount / 100}}—{{item.scope.maxMonthlyFeeAmount / 100}} 元；押金 {{item.scope.minDepositAmount / 100}}—{{item.scope.maxDepositAmount / 100}} 元</view><view class="small muted">范围摘要 {{item.scopeHash}}</view><button class="secondary" data-id="{{item.id}}" data-action="refresh" bindtap="grantAction" disabled="{{busy}}">查询渠道授权状态</button><button wx:if="{{!item.enabled && item.status === 'AUTHORIZED'}}" class="primary" data-id="{{item.id}}" data-action="enable" bindtap="grantAction" disabled="{{busy}}">确认此范围并开启</button><button class="secondary" data-id="{{item.id}}" data-action="disable" bindtap="grantAction" disabled="{{busy}}">关闭本地自动签署</button><button class="text-button" data-id="{{item.id}}" data-action="revoke" bindtap="grantAction" disabled="{{busy}}">本人撤销渠道授权 →</button></view>
 <view class="card"><view class="section-title">本企业订阅合同</view><view wx:if="{{!contracts.length}}" class="muted">尚无已准备合同。客户逐单同意资料提供、运营生成合同后在此查看。</view><button wx:for="{{contracts}}" wx:key="id" class="text-button" data-id="{{item.id}}" bindtap="openContract" disabled="{{busy}}">{{item.resourceId}} · {{item.statusText}} →</button></view>
 <view wx:if="{{record}}" class="card"><view class="section-title">{{record.statusText}}</view><view>{{record.modeText}}</view><view wx:for="{{record.parties}}" wx:key="role">{{item.role === 'OWNER' ? '企业车主' : '订阅客户'}}：{{item.status === 'SIGNED' ? '已核验签署' : '尚待核验签署'}}</view><view class="body">{{record.body}}</view><button class="secondary" data-kind="source" bindtap="openPdf" disabled="{{busy}}">打开本份完整合同 PDF</button><button wx:if="{{record.signedFileId}}" class="secondary" data-kind="signed" bindtap="openPdf" disabled="{{busy}}">打开双方签后归档 PDF</button><view class="small muted">文件摘要 {{record.sourceSha256}}</view><block wx:if="{{record.canSign || record.canChooseManual}}"><button wx:if="{{record.canChooseManual}}" class="secondary" bindtap="manual" disabled="{{busy}}">本份选择手动确认</button><checkbox-group data-field="documentAccepted" bindchange="accepted"><label><checkbox value="yes" checked="{{documentAccepted}}" disabled="{{busy}}"/><text>我已核对本份全文、完整 PDF、实际出租方与全部逐单条件，由本企业签署此份合同。</text></label></checkbox-group><button class="primary" bindtap="sign" disabled="{{busy || !record.canSign || !record.reviewedAt || !documentAccepted || !pdfRead}}">进入本企业手动签署</button></block><button class="secondary" bindtap="sync" disabled="{{busy}}">主动核验双方签署与归档</button></view></block>
</view>
