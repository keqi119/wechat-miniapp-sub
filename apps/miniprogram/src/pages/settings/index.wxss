.setting-heading {
  margin-top: 40rpx;
}
.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.settings-card-header,
.settings-contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.settings-card-header .section-title,
.settings-section-title {
  margin-top: 0;
}
.settings-card-header .section-title {
  margin-bottom: 0;
}
.settings-card-header {
  margin-bottom: 24rpx;
}
.settings-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 0;
  background: transparent;
  color: #231815;
  font-size: 40rpx;
  line-height: 1;
}
.settings-legal {
  margin-top: 24rpx;
}
.settings-contact {
  justify-content: flex-end;
  margin-top: 32rpx;
}
.settings-contact text {
  overflow-wrap: anywhere;
}
.settings-retry {
  min-height: 44px;
}
.settings-payment {
  margin: 32rpx 0;
}
.settings-logout {
  margin-top: 32rpx;
}
