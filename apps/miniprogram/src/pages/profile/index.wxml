<view class="page"><view class="eyebrow">PROFILE / {{applicationId ? '补充审查资料' : '个人资料'}}</view><view class="title">认识用车的人。</view>
<view wx:if="{{loading}}" class="empty">正在读取资料…</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button wx:if="{{authRequired}}" class="primary" bindtap="openLogin">登录账户</button><button class="secondary" bindtap="reload">重新加载</button></view>
<block wx:else><view class="notice">{{applicationId ? reviewNote : '资料保存到当前账户。认证手机号如需变更，请重新登录验证。'}}</view><view class="card">
<view class="field"><view class="label">姓名</view><input class="input" value="{{name}}" maxlength="30" data-field="name" bindinput="input" disabled="{{busy}}"/></view>
<view class="field"><view class="label">认证手机号</view><input class="input" value="{{mobile}}" disabled="{{true}}"/></view>
<view class="field"><view class="label">驾龄（年）</view><input class="input" type="number" value="{{drivingYears}}" maxlength="2" data-field="drivingYears" bindinput="input" disabled="{{busy}}"/></view></view>
<view class="card"><view class="section-title">私密资料附件</view><view class="muted">最多4张，每张不超过10MB，仅当前账户和授权审核人员可查看。</view><view wx:for="{{attachments}}" wx:key="id" class="row between"><button class="text-button" data-id="{{item.id}}" bindtap="openAttachment">{{item.name}}</button><button class="text-button" data-index="{{index}}" bindtap="removeAttachment" disabled="{{busy}}">移除</button></view><button class="secondary" bindtap="chooseAttachments" disabled="{{busy || choosing || attachments.length >= 4}}" loading="{{choosing}}">上传资料图片</button></view>
<view wx:if="{{applicationId}}" class="card"><view class="label">补充说明</view><textarea class="textarea" value="{{note}}" maxlength="500" data-field="note" bindinput="input" disabled="{{busy}}"/></view>
<view wx:if="{{message}}" class="notice">{{message}}</view><button class="primary" bindtap="submit" disabled="{{busy || choosing}}" loading="{{busy}}">{{applicationId ? '提交补充资料' : '保存资料'}}</button></block></view>
