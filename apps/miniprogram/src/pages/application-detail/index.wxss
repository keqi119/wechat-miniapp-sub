.status-header {
  padding: 36rpx 0 40rpx;
  border-bottom: 1rpx solid #d1d6c7;
}
.status-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  background: #e9e7db;
  border: 1rpx solid #d4d4c5;
  border-radius: 50%;
  color: #715300;
  font-size: 45rpx;
  margin: 32rpx 0 22rpx;
}
.status-header .title {
  margin: 14rpx 0;
}
.application-id {
  font-size: 24rpx;
  color: #747b6b;
  margin-top: 24rpx;
  word-break: break-all;
}
.summary-card {
  padding: 30rpx 0;
}
.summary-card > .section-title {
  margin-bottom: 18rpx;
}
.summary-row {
  align-items: flex-start;
  gap: 26rpx;
  padding: 17rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}
.summary-row > text:last-child {
  text-align: right;
  max-width: 67%;
}
.progress-section {
  border-top: 1rpx solid #d1d6c7;
  padding: 32rpx 0;
}
.progress-section > .section-title {
  margin-bottom: 30rpx;
}
.timeline-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  padding-bottom: 32rpx;
  min-height: 88rpx;
}
.timeline-item:before {
  content: '';
  position: absolute;
  left: 17rpx;
  top: 38rpx;
  bottom: 0;
  width: 1rpx;
  background: #d3d8ca;
}
.timeline-item:last-child:before {
  display: none;
}
.timeline-marker {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  border: 1rpx solid #c3cbb8;
  border-radius: 50%;
  color: #8b9282;
  background: #f5f6f7;
  font-size: 25rpx;
  box-sizing: border-box;
}
.done .timeline-marker {
  background: #4b5f45;
  border-color: #4b5f45;
  color: #fff;
  font-size: 24rpx;
}
.timeline-title {
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.timeline-copy .muted {
  font-size: 24rpx;
  line-height: 1.7;
}
.final-plan {
  padding: 28rpx;
  border: 1rpx solid #715300;
  background: #faf6ee;
}
.version {
  font-size: 24rpx;
  color: #715300;
}
.final-plan .section-title {
  margin: 18rpx 0;
}
.final-caption {
  font-size: 24rpx;
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.final-price {
  padding: 22rpx 0;
  border-top: 1rpx solid #dedbce;
  margin-top: 12rpx;
  gap: 20rpx;
}
.plan-notes {
  font-size: 24rpx;
  line-height: 1.8;
  margin-top: 18rpx;
  white-space: pre-wrap;
}
.plan-read {
  display: flex;
  gap: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  border-top: 1rpx solid #dedbce;
  margin-top: 26rpx;
  padding-top: 24rpx;
}
.plan-read checkbox {
  flex-shrink: 0;
  transform: scale(0.85);
  transform-origin: top left;
}
.flow-note {
  margin: 26rpx 0;
}
.detail-navigation {
  padding-top: 10rpx;
}
.detail-page {
  padding-bottom: calc(270rpx + env(safe-area-inset-bottom));
}
.rejection-section {
  margin-top: 28rpx;
  border-top: 1rpx solid #dedbce;
}
.application-actions .text-button {
  justify-content: center;
}
.final-benefits {
  font-size: 26rpx;
  line-height: 1.7;
  padding: 17rpx 0;
}
.final-benefit {
  display: flex;
  gap: 14rpx;
  padding-top: 14rpx;
}
.benefit-check {
  color: #4b5f45;
  flex-shrink: 0;
}
.compact-header { padding: 24rpx 0; border-bottom: 0; }
.compact-header .title { font-size: 42rpx; margin: 8rpx 0; }
.compact-header .application-id { margin-top: 8rpx; }
.detail-page > .card { margin-bottom: 20rpx; }
.card .section-title { margin: 0 0 16rpx; font-size: 31rpx; }
.plan-overview { border-top: 5rpx solid #fcc900; }
.overview-vehicle { font-size: 32rpx; font-weight: 600; margin: 10rpx 0 18rpx; }
.overview-prices, .overview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.overview-prices { border-bottom: 1rpx solid #dedbce; padding-bottom: 20rpx; margin-bottom: 18rpx; }
.overview-prices .price { font-size: 40rpx; }
.price-unit { font-size: 24rpx; font-weight: 400; }
.deposit-price { font-size: 32rpx; margin-top: 4rpx; }
.overview-grid { font-size: 26rpx; }
.overview-lessor { border-top: 1rpx solid #dedbce; padding-top: 14rpx; font-size: 26rpx; }
.plan-overview .summary-row { font-size: 24rpx; padding: 10rpx 0; }
.confirmation-steps { display: flex; justify-content: space-between; font-size: 24rpx; padding: 6rpx 0 22rpx; color: #715300; }
.status-chip { white-space: nowrap; font-size: 24rpx; background: #ede5d9; padding: 5rpx 14rpx; border-radius: 4rpx; }
.compact-link { min-height: 68rpx; padding: 12rpx 0; font-size: 24rpx; }
.document-entry .secondary { margin-top: 16rpx; }
.final-plan { margin: 0 0 20rpx; }
.confirmation-section .plan-read { margin-top: 18rpx; padding-top: 18rpx; font-size: 24rpx; }
.lessor-details { background: #faf6ee; padding: 18rpx; font-size: 24rpx; }
.confirmation-note { padding-top: 20rpx; }
.rejection-section .field { margin-top: 18rpx; }
.secondary-actions { display: flex; justify-content: space-between; gap: 20rpx; }
