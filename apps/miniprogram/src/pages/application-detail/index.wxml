<view class="page bottom-space detail-page">
  
  <view wx:if="{{loading}}" class="empty" role="status">正在加载申请进度…</view>
  <view wx:elif="{{error}}" class="empty"
    ><view>{{error}}</view><button class="secondary" bindtap="refresh">重新加载</button
    ><button class="text-button" bindtap="openCatalog">返回选车</button></view
  >
  <view wx:elif="{{!application}}" class="empty"
    ><view class="section-title">还没有这份申请</view
    ><view class="muted">可以先挑选车辆与预设套餐。</view
    ><button class="primary" bindtap="openCatalog">去选车</button
    ><button class="text-button" bindtap="refresh">刷新申请</button></view
  >
  <block wx:else>
    <view class="status-header"
      ><view class="eyebrow">YOUR APPLICATION</view
      ><view class="status-symbol"
        >{{application.status === 'AWAITING_CONFIRMATION' ? '!' : '↗'}}</view
      ><view class="title">{{application.statusText}}</view
      ><view class="muted">{{application.title || '订阅申请'}}</view
      ><view class="application-id">申请编号 {{application.id}}</view></view
    >
    <view wx:if="{{actionMessage}}" class="notice action-message" role="status"
      >{{actionMessage}}</view
    >
    <view class="summary-card"
      ><view class="section-title">申请意向</view
      ><view class="summary-row row between"
        ><text class="muted">车辆</text><text>{{application.vehicleName}}</text></view
      ><view class="summary-row row between"
        ><text class="muted">预设套餐</text><text>{{application.planTitle}}</text></view
      ><view class="summary-row row between"
        ><text class="muted">意向月费</text><text>{{application.monthlyFeeText}}</text></view
      ><view class="summary-row row between"
        ><text class="muted">押金</text
        ><text>{{application.depositText || '待审核确认'}}</text></view
      ></view
    >
    <view class="card">
      <view class="section-title">本申请的人工信用核验</view>
      <view class="muted">由运营核对你主动出示的本人页面，仅记录档位；请勿上传信用页面截图或提供账号密码、验证码。</view>
      <view wx:if="{{creditError}}" class="notice" role="alert">{{creditError}}</view>
      <view wx:if="{{creditMessage}}" class="notice" role="status">{{creditMessage}}</view>
      <block wx:if="{{creditReview}}">
        <view>{{creditReview.statusText}}</view><view class="muted">{{creditReview.consentStatusText}}</view>
        <button wx:if="{{creditReview.document}}" class="text-button" bindtap="openCreditExplanation">{{creditReview.document.title}} · 版本 {{creditReview.document.version}} →</button>
        <view wx:else class="notice">当前正式核验说明暂不可用，不能提交授权；可联系人工处理。</view>
        <block wx:if="{{creditReview.document}}">
          <view class="muted small">750分及以上：押金0元；700—749分：最终方案中1个月订阅费；650—699分：2个月订阅费。低于650分或无法核验转人工处理，暂不生成正式方案。月费不因核验改变，金额以最终确认方案为准。</view>
          <block wx:if="{{!creditReview.consentRequirementsMet && creditReview.status !== 'HISTORICAL'}}"><view class="notice">接受核验授权前，请先更新当前用户协议与隐私政策的同意记录；暂不授权或撤回仍可操作。</view><button class="secondary" bindtap="openCreditSettings" disabled="{{busy}}">到账户设置查看并更新协议</button></block>
          <block wx:if="{{creditReview.canConsent && !creditReview.consentCurrent}}">
            <checkbox-group bindchange="onCreditAccepted"><label class="plan-read"><checkbox value="credit" color="#B44919" checked="{{creditAccepted}}" disabled="{{busy}}"/><text>我已阅读上述说明，单独同意为审核本次申请及确定押金，由运营核对我主动出示的本人芝麻分，并按说明记录档位及核验信息。我了解可以拒绝、撤回或申请人工复核。</text></label></checkbox-group>
            <button class="primary" bindtap="acceptCreditConsent" disabled="{{busy || !creditAccepted}}" loading="{{busy}}">单独授权本申请人工核验</button>
          </block>
          <button wx:if="{{creditReview.canDecline}}" class="secondary" bindtap="declineCreditConsent" disabled="{{busy}}">暂不授权，转人工联系处理</button>
        </block>
        <block wx:if="{{creditReview.verification}}"><view class="section-title">运营已记录的核验</view><view>档位：{{creditReview.bandText}}</view><view class="muted small">核验时间：{{creditReview.verifiedAtText}}</view><view>{{creditReview.depositRuleText}}</view><view class="muted small">押金规则 {{creditReview.ruleVersion}}</view><view wx:if="{{!creditReview.verificationCurrent}}" class="notice">此记录不能用于继续确认新的方案；当前申请状态或授权发生变化时，请联系人工核对。已有合同保留当时确认的押金依据。</view></block>
        <button wx:if="{{creditReview.canWithdraw}}" class="text-button" bindtap="withdrawCreditConsent" disabled="{{busy}}">撤回本申请后续核验授权</button>
      </block>
      <button class="secondary" bindtap="contactCreditService" disabled="{{busy}}">联系人工客服</button>
      <button class="text-button" bindtap="refresh" disabled="{{busy}}">刷新申请与核验状态</button>
    </view>
    <view class="progress-section"
      ><view class="section-title">办理进度</view
      ><view
        wx:for="{{application.timeline}}"
        wx:key="title"
        class="timeline-item {{item.done ? 'done' : ''}}"
        ><view class="timeline-marker">{{item.done ? '✓' : '·'}}</view
        ><view class="timeline-copy"
          ><view class="timeline-title">{{item.title}}</view
          ><view class="muted">{{item.description}}</view></view
        ></view
      ></view
    >
    <view wx:if="{{application.finalPlan}}" class="final-plan"
      ><view class="row between"
        ><view class="eyebrow">FINAL PLAN</view
        ><text class="version">版本 {{application.finalPlan.revision}}</text></view
      ><view class="section-title">最终方案</view
      ><view class="muted final-caption"
        >请逐项核对。车辆、价格或方案版本变更后，需要重新阅读并确认。</view
      ><view class="summary-row row between"
        ><text class="muted">车辆</text><text>{{application.finalPlan.vehicleName}}</text></view
      ><view class="summary-row row between"
        ><text class="muted">套餐</text><text>{{application.finalPlan.planTitle}}</text></view
      ><view class="summary-row row between"
        ><text class="muted">订阅期限</text
        ><text>{{application.finalPlan.termMonths}} 个月</text></view
      ><view class="summary-row row between"
        ><text class="muted">包含里程</text><text>{{application.finalPlan.mileageText}}</text></view
      ><view class="summary-row row between"
        ><text class="muted">能源说明</text><text>{{application.finalPlan.energyText}}</text></view
      ><view class="final-benefits"
        ><view class="muted">包含权益</view
        ><view wx:for="{{application.finalPlan.benefits}}" wx:key="*this" class="final-benefit"
          ><text class="benefit-check">✓</text><text>{{item}}</text></view
        ></view
      ><view class="final-price row between"
        ><text>月费</text><text class="price">{{application.finalPlan.monthlyFeeText}}</text></view
      ><view class="summary-row row between"
        ><text class="muted">押金</text><text>{{application.finalPlan.depositText}}</text></view
      ><view wx:if="{{application.finalPlan.pricingDescription}}" class="notice">{{application.finalPlan.pricingDescription}}</view
      ><view class="summary-row row between"><text class="muted">超里程单价</text><text>{{application.finalPlan.excessMileagePriceText}} / 公里</text></view
      ><view class="summary-row row between"><text class="muted">起租日期</text><text>{{application.finalPlan.startDateText}}</text></view
      ><view class="summary-row row between"><text class="muted">结束日期</text><text>{{application.finalPlan.endDateText}}</text></view
      ><view class="summary-row row between"><text class="muted">首期付款及押金支付日</text><text>{{application.finalPlan.firstDueDateText}}</text></view
      ><view class="final-benefits"><view class="section-title">逐期账单与服务期间</view><view wx:for="{{application.finalPlan.billingRows}}" wx:key="sequence" class="plan-notes"><view>第 {{item.sequence}} 期 · {{item.amountText}} · 到期 {{item.dueDateText}}</view><view>{{item.periodText}}</view></view></view
      ><view class="final-benefits"><view class="section-title">逐单商业约定</view><view wx:for="{{application.finalPlan.commercialRows}}" wx:key="key" class="plan-notes"><view class="muted">{{item.label}}</view><view>{{item.value || '未填写，请联系运营重出完整方案'}}</view></view></view
      ><view wx:if="{{application.finalPlan.usagePolicy}}" class="final-benefits"><view class="section-title">本方案固定的月里程与加购、退订规则</view><view class="muted small">正式文案版本 {{application.finalPlan.usagePolicy.documentVersion}} · {{application.finalPlan.usagePolicy.version}}</view><view class="plan-notes">{{application.finalPlan.usagePolicy.content}}</view></view><view wx:if="{{!application.finalPlan.usagePolicyComplete}}" class="notice">本方案尚未固定完整、已批准的月里程用量规则，不能确认；请联系运营重新出具方案。</view
      ><view wx:if="{{!application.finalPlan.complete}}" class="notice">此方案资料尚不完整，请联系运营重新发布；补齐后再阅读确认。</view
      ><view class="plan-notes">{{application.finalPlan.notes}}</view
      ><checkbox-group
        wx:if="{{application.status === 'AWAITING_CONFIRMATION'}}"
        bindchange="onPlanRead"
        ><label class="plan-read"
          ><checkbox value="read" color="#B44919" checked="{{planRead}}" disabled="{{busy}}" /><text
            >我已阅读当前版本全部商业约定、保险与免责、用车限制、各期费用、押金、月里程用量及加购、退订规则。</text
          ></label
        ></checkbox-group
      ></view
    >
    <view wx:if="{{application.status === 'NEEDS_INFO'}}" class="card"><view class="section-title">补充审查资料</view><view class="muted">{{application.note}}</view><button class="primary" bindtap="openAmendment">补充资料并重新提交</button></view>
    <view wx:if="{{actionError}}" class="action-error" role="alert"
      >{{actionError}}<button class="text-button" bindtap="refresh" disabled="{{busy}}"
        >重新加载最新方案</button
      ></view
    >
    <view class="notice flow-note"
      >申请不等于正式订单。只有确认最终方案后才进入订单流程，签约、支付和交付仍需分别完成。</view
    >
    <button
      wx:if="{{application.status === 'SUBMITTED' || application.status === 'IN_REVIEW' || application.status === 'NEEDS_INFO' || application.status === 'AWAITING_CONFIRMATION'}}"
      class="text-button"
      bindtap="cancelApplication"
      disabled="{{busy}}"
      >取消申请</button
    >
    <view
      wx:if="{{application.status === 'AWAITING_CONFIRMATION' && application.finalPlan}}"
      class="sticky-actions"
      ><view class="field"><view class="label">暂不接受原因（拒绝方案时必填）</view><textarea class="textarea" value="{{rejectReason}}" bindinput="onRejectReason" maxlength="500" disabled="{{busy}}"/></view><button class="primary" bindtap="confirmPlan" loading="{{busy}}" disabled="{{busy}}"
        >确认最终方案</button
      ><button class="text-button" bindtap="rejectPlan" disabled="{{busy}}"
        >暂不接受此方案</button
      ></view
    >
    <view wx:else class="detail-navigation"
      ><button class="primary" bindtap="openUse">查看用车与待办</button
      ><button class="text-button" bindtap="refresh">刷新申请进度</button></view
    >
  </block>
</view>
