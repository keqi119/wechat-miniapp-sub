.current-car {
  margin-top: 24rpx;
}
.use-title { font-size: 48rpx; margin: 20rpx 0 28rpx; }
.vehicle-name {
  font-size: 40rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
  overflow-wrap: anywhere;
}
.vehicle-stage { font-size: 25rpx; line-height: 1.65; margin-top: 18rpx; }
.subscription-metrics { align-items: center; }
.next-step { margin-top: 28rpx; padding: 22rpx 24rpx; background: #fff6ce; border-left: 3rpx solid #fcc900; font-size: 27rpx; line-height: 1.65; }
.next-step-label { color: #715300; font-size: 24rpx; margin-bottom: 8rpx; }
.order-action { margin-top: 24rpx; }
.records-card .menu-row + .menu-row { border-top: 1rpx solid #e5e3d8; }
.section-gap {
  margin-top: 48rpx;
}
.service-tile {
  background: #ebeae4;
  text-align: left;
  padding: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
  border-radius: 8rpx;
  width: 100%;
}
.service-tile text {
  display: block;
}
.service-tile .muted {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.tile-number {
  font-size: 24rpx;
  color: #715300;
  margin-bottom: 24rpx;
}
.menu-row {
  display: flex;
  justify-content: space-between;
  background: transparent;
  font-size: 30rpx;
  text-align: left;
  padding: 24rpx 0;
}
.todo + .todo {
  margin-top: 20rpx;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}

/* Bright native 2026-11-02 */
.use-title{font-size:48rpx;margin:12rpx 0 26rpx}.current-car{border:1rpx solid #e9e7e3}.vehicle-name{font-size:40rpx;margin:18rpx 0 10rpx}.vehicle-stage{font-size:26rpx;color:#65615c}.subscription-metrics{align-items:start;gap:24rpx}.subscription-metrics .price{font-size:44rpx}.subscription-metrics .label{color:#65615c;font-size:24rpx}.next-step{border:0;border-radius:16rpx;background:#fff6d8;padding:24rpx;margin-top:24rpx;font-size:28rpx}.next-step-label{color:#231815}.service-tile{background:#ffffff;border:1rpx solid #e1e1de;border-radius:24rpx;padding:26rpx;font-size:30rpx;min-height:220rpx}.tile-number{display:inline-block!important;background:#fcc900;color:#231815;border-radius:10rpx;padding:5rpx 12rpx;font-size:24rpx;margin-bottom:18rpx}.menu-row{width:100%;gap:16rpx;min-height:96rpx}.menu-row>text:first-child{min-width:0}.records-card{padding:8rpx 28rpx}.records-card .menu-row+.menu-row{border-color:#e9e7e3}.section-gap{margin-top:36rpx}

.addon-entry-group{margin:30rpx 0}.addon-entry-group>.section-title{margin-bottom:18rpx}.addon-entry{background:#fff;border:1rpx solid #e9e4d9;border-radius:22rpx;padding:26rpx 22rpx;text-align:left;width:100%;line-height:1.5}.addon-entry-name{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:600;margin-bottom:10rpx}.addon-entry-name text{font-size:26rpx;color:#231815}.addon-entry .muted{font-size:23rpx}.addon-entry-note{font-size:22rpx;color:#231815;background:#fff6d6;border-radius:8rpx;padding:6rpx 10rpx;margin-top:16rpx;white-space:normal}
