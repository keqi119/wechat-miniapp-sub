<view class="page bottom-space main-tab-page {{mainTabMotion}}"
  ><view class="eyebrow">账户与服务</view
  ><view class="title">我的订阅档案</view
  ><view wx:if="{{loading}}" class="empty">正在读取账户信息…</view
  ><view wx:elif="{{!authenticated}}" class="card"
    ><view class="section-title">尚未登录</view
    ><view class="muted">{{error || '登录后办理订阅与用车服务。'}}</view
    ><button class="primary" bindtap="openLogin">登录账户</button></view
  ><block wx:else
    ><view class="card identity identity-entry" data-url="/pages/profile/index" bindtap="open" role="button" aria-label="打开个人资料：{{profile.name || '个人资料'}}，{{profile.mobile || '查看本人资料'}}"
      ><view class="profile-mark"><image src="/assets/person-active.png" mode="aspectFit" aria-hidden="true" /></view
      ><view class="identity-text"
        ><view class="section-title">{{profile.name || '个人资料'}}</view
        ><view class="muted">{{profile.mobile || '查看本人资料'}}</view></view><text class="identity-arrow muted" aria-hidden="true">→</text
      ></view
    ><view wx:if="{{error}}" class="empty"
      ><view>{{error}}</view><button wx:if="{{authRequired}}" class="primary" bindtap="openLogin">登录账户</button><button class="secondary" bindtap="reload">重新加载</button></view
    ><block wx:else
    ><view class="notice">订阅、合同和账单均以当前账户的服务端记录为准。</view
    ><view class="card"
      ><button class="menu-row" bindtap="openApplication"
        ><view
          ><view>我的申请</view
          ><view class="muted small"
            >{{application ? application.statusText : '尚未提交，前往选车'}}</view
          ></view
        ><text>→</text></button
      ></view
    ><view class="card"
      ><button
        wx:for="{{links}}"
        wx:key="type"
        class="menu-row"
        data-type="{{item.type}}"
        bindtap="openRecords"
        ><text>{{item.title}}</text><text class="muted">→</text></button
      ></view
    ></block></block
  ></view>
