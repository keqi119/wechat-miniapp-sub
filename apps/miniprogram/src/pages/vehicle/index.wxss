.vehicle-gallery {
  height: 100%;
  width: 100%;
}
.gallery-counter {
  position: absolute;
  right: 24rpx;
  bottom: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
  background: rgba(35, 24, 21, 0.72);
  color: #fff;
  font-size: 20rpx;
  pointer-events: none;
}
