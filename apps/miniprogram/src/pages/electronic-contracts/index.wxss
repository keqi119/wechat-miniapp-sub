.signer-slots{display:flex;gap:12rpx;margin:24rpx 0}.signer-slot{flex:1;min-width:0;text-align:center;border:1rpx solid #e5e5e5;border-radius:16rpx;padding:20rpx 8rpx;line-height:1.6}.signer-check{font-size:36rpx}.signer-slot.signed{background:#fff5c2;border-color:#f7c600}.pagination text{white-space:nowrap;flex-shrink:0}
.source-hash { overflow-wrap: anywhere; word-break: break-all; } .consent-row { display:flex; gap:16rpx; margin:24rpx 0; line-height:1.8; } .row { flex-wrap:wrap; gap:12rpx; } .record-card { text-align:left; width:100%; white-space:normal; }
.pagination { display:flex; align-items:center; gap:12rpx; margin:20rpx 0; } .pagination button { flex:1; min-width:0; margin:0; padding:0 12rpx; font-size:24rpx; } .pagination text { font-size:24rpx; } .record-card { display:block; background:#fff; border:1rpx solid #e9e7e3; border-radius:24rpx; padding:24rpx; margin:16rpx 0; }
