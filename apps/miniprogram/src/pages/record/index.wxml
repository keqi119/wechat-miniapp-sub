<view class="page bottom-space {{type === 'contracts' ? 'contract-page' : ''}}"
  >
<button wx:if="{{(type === 'orders' || type === 'contracts') && record.contractMode !== 'OFFLINE' && !loading && !error}}" class="secondary" bindtap="openElectronicContracts">电子合同 / 签署与历史</button>
<view wx:if="{{loading}}" class="empty">正在读取详情…</view
  ><view wx:elif="{{error}}" class="empty"
    ><view>{{error}}</view><view wx:if="{{changeKind === 'SUBSCRIPTION_EXTENSION' && message}}" class="notice" role="status">{{message}}</view><button class="secondary" bindtap="reload">重新加载</button
    ><button class="text-button" bindtap="openList">返回记录列表</button></view
  ><view wx:elif="{{!record}}" class="empty"
    ><view>未找到这条记录</view
    ><button class="secondary" bindtap="openList">查看记录列表</button></view
  ><block wx:else
    ><block wx:if="{{type === 'contracts'}}">
      <view class="eyebrow">CONTRACT / 合同</view>
      <view class="contract-heading"><view class="contract-title">{{contract.available ? contract.phaseText : '合同信息待核对'}}</view><view wx:if="{{contract.available}}" class="contract-subtitle">{{contract.kind === 'AMENDMENT' ? '订阅补充协议' : '车辆订阅合同'}}</view></view>
      <block wx:if="{{contract.available}}">
        <view class="contract-guidance"><view class="contract-guidance-title">{{contract.guidance.title}}</view><view>{{contract.guidance.description}}</view></view>
        <view class="card contract-summary"><view class="contract-vehicle">{{contract.vehicle.title}}</view><view class="contract-summary-grid"><view wx:for="{{contract.summaryRows}}" wx:key="label" class="contract-summary-item"><view class="label">{{item.label}}</view><view class="contract-summary-value {{index < 2 ? 'contract-money' : ''}}">{{item.value}}</view></view></view><view class="contract-lessor"><view class="label">实际出租方</view><view>{{contract.lessor.name}}</view></view></view>
        <view class="card contract-progress"><view class="section-title">{{contract.offline ? "线下签署与归档" : "签署进度"}}</view><view wx:for="{{contract.progress}}" wx:key="id" class="contract-step contract-step-{{item.state}}"><view class="contract-step-marker"><view class="contract-step-dot"/><view wx:if="{{index < contract.progress.length - 1}}" class="contract-step-line"/></view><view class="contract-step-title">{{item.title}}</view><text class="contract-step-status">{{item.state === 'DONE' ? '已完成' : item.state === 'CURRENT' ? '当前步骤' : item.state === 'STOPPED' ? '已停止' : '待进行'}}</text></view><view wx:if="{{!contract.progress.length}}" class="muted">签署步骤尚待核对。</view></view>
        <view class="card contract-parties"><view class="section-title">{{contract.offline ? "合同三方" : "双方签署状态"}}</view><view wx:for="{{contract.parties}}" wx:key="role" class="contract-party"><view class="contract-party-top"><view class="label">{{item.label}}</view><text class="tag">{{item.statusText}}</text></view><view class="contract-party-name">{{item.name}}</view></view><view wx:if="{{!contract.parties.length}}" class="muted">签署方信息尚待核对。</view></view>
        <view class="card contract-documents"><view class="section-title">合同文件</view><button wx:for="{{contract.documents}}" wx:key="id" class="contract-document" data-id="{{item.id}}" bindtap="openContractDocument" disabled="{{busy}}"><view><view>{{item.label}}</view><view class="muted small">{{item.title}}</view></view><text class="contract-document-arrow">查看 →</text></button><view wx:if="{{!contract.documents.length}}" class="muted">正式合同文件准备完成后将在这里提供。</view></view>
        <button wx:if="{{contract.offline}}" class="secondary" bindtap="openOfflineContract">查看订单与资料反馈</button><button wx:if="{{!contract.offline && contract.kind === 'AMENDMENT'}}" class="secondary" bindtap="openOrderChanges">查看订阅变更方案与签署进度</button>
      </block>
      <view wx:else class="notice">合同信息暂未提供或版本待核对。请重新加载；如仍无法查看，请联系运营核对本单信息。</view>
      <view class="contract-tools"><button class="text-button" disabled="{{busy}}" bindtap="refreshContract">{{contract.canQuery ? '刷新并核验签署进度' : '刷新合同信息'}} ↻</button><button class="text-button" bindtap="openList">查看全部合同 →</button></view>
      <view class="contract-meta"><view class="label">合同编号</view><view class="record-id">{{id}}</view><block wx:if="{{contract.available}}"><view class="contract-meta-row"><text>模板版本</text><text>{{contract.templateVersion || '待核对'}}</text></view><view class="contract-meta-row"><text>创建时间</text><text>{{contract.createdAtText}}</text></view><view class="contract-meta-row"><text>更新时间</text><text>{{contract.updatedAtText}}</text></view></block></view>
      <view class="contract-actions"><button class="secondary" data-id="{{contract.sourceFileId}}" disabled="{{busy || !contract.available || !contract.sourceFileId}}" bindtap="openContractDocument">合同全文</button><button wx:if="{{contract.primaryAction}}" class="primary" data-action="{{contract.primaryAction.id}}" bindtap="contractAction" loading="{{busy}}" disabled="{{busy}}">{{contract.primaryAction.label}}</button><view wx:else class="contract-action-status">{{contract.available ? contract.phaseText : '信息待核对'}}</view></view>
    </block><block wx:elif="{{type === 'orders' && order}}">
      <view class="eyebrow">SUBSCRIPTION / 订单</view>
      <view class="order-heading"><view class="order-title">{{order.available ? order.vehicle.title : '车辆订阅订单'}}</view><text class="tag">{{order.statusText}}</text></view>
      <block wx:if="{{order.available}}">
        <view class="card order-summary"><view class="order-summary-grid"><view wx:for="{{order.summaryRows}}" wx:key="label" class="order-summary-item"><view class="label">{{item.label}}</view><view class="order-summary-value {{index < 2 ? 'order-money' : ''}}">{{item.value}}</view></view></view></view>
        <view class="order-guidance"><view class="section-title">{{order.guidance.title}}</view><view>{{order.guidance.description}}</view></view>
        <view class="card order-related"><view class="section-title">合同</view><view wx:if="{{!order.contracts.length}}" class="muted">暂无可查看的合同记录。</view><view wx:for="{{order.contracts}}" wx:key="id" class="order-related-item"><view class="row between"><view class="related-title">{{item.title}}</view><text class="tag">{{item.statusText}}</text></view><view class="muted related-description">{{item.description}}</view><view wx:if="{{item.dateText}}" class="muted small">{{item.dateText}}</view><button wx:if="{{item.url}}" class="secondary related-action" data-group="contracts" data-id="{{item.id}}" bindtap="openOrderRelated">查看合同</button><button wx:for="{{item.documents}}" wx:for-item="file" wx:key="id" class="text-button" data-group="contracts" data-id="{{item.id}}" data-file-id="{{file.id}}" bindtap="openOrderDocument" disabled="{{busy}}">{{file.title}} →</button></view></view>
        <block wx:for="{{order.sections}}" wx:key="id"><view wx:if="{{!item.collapsible}}" class="card order-section"><view class="section-title">{{item.title}}</view><view wx:for="{{item.rows}}" wx:for-item="row" wx:key="label" class="order-field"><view class="label">{{row.label}}</view><view class="order-field-value">{{row.value}}</view></view></view></block>
        <view class="card order-related"><view class="section-title">账单</view><view wx:if="{{!order.bills.length}}" class="muted">暂无已发布账单。</view><view wx:for="{{order.bills}}" wx:key="id" class="order-related-item"><view class="row between"><view class="related-title">{{item.title}}</view><text class="tag">{{item.statusText}}</text></view><view wx:if="{{item.amountText}}" class="related-amount">{{item.amountText}}</view><view class="muted related-description">{{item.description}}</view><view wx:if="{{item.dateText}}" class="muted small">{{item.dateText}}</view><button wx:if="{{item.url}}" class="secondary related-action" data-group="bills" data-id="{{item.id}}" bindtap="openOrderRelated">查看账单</button></view></view>
        <view class="card order-related"><view class="section-title">车辆交接</view><view wx:if="{{!order.handovers.length}}" class="muted">暂无已发布交接记录。</view><view wx:for="{{order.handovers}}" wx:key="id" class="order-related-item"><view class="row between"><view class="related-title">{{item.title}}</view><text class="tag">{{item.statusText}}</text></view><view class="muted related-description">{{item.description}}</view><view wx:if="{{item.dateText}}" class="muted small">{{item.dateText}}</view><button wx:if="{{item.url}}" class="secondary related-action" data-group="handovers" data-id="{{item.id}}" bindtap="openOrderRelated">查看交接记录</button></view></view>
        <view wx:if="{{order.hasExpandableTerms}}" class="card order-terms"><button class="order-disclosure" bindtap="toggleOrderTerms"><text>完整方案与交易条件</text><text>{{showOrderTerms ? '收起 −' : '展开 +'}}</text></button><block wx:if="{{showOrderTerms}}"><block wx:for="{{order.sections}}" wx:key="id"><view wx:if="{{item.collapsible}}" class="order-term-section"><view class="section-title">{{item.title}}</view><view wx:for="{{item.rows}}" wx:for-item="row" wx:key="label" class="order-field"><view class="label">{{row.label}}</view><view class="order-field-value">{{row.value}}</view></view></view></block></block></view>
        <view class="order-tools"><button class="text-button" bindtap="openOrderUsage">月里程、里程包与退订结算 →</button><button class="text-button" bindtap="openOrderChanges">订阅变更记录 →</button></view>
      </block>
      <view wx:else class="notice order-unavailable">订单摘要暂未提供或版本待核对。请重新加载；如仍无法查看，请联系运营核对本单信息。</view>
      <view class="order-meta"><view class="label">订单编号</view><view class="record-id">{{order.id}}</view><view class="label">创建时间</view><view>{{order.createdAtText}}</view></view>
      <button class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="refreshOrder">刷新订单</button><button class="text-button back-link" bindtap="openList">查看全部订单 →</button>
    </block><block wx:elif="{{type === 'orderchanges' && change.isRenewal}}">
      <view class="eyebrow">RENEWAL / 同车续期</view><view class="title">{{change.title}}</view>
      <view class="record-summary"><text class="tag">{{change.statusText}}</text><view class="muted">流程版本 {{change.revision}} · 记录 {{change.id}}</view></view>
      <view class="notice">本方案只追加同一实际车辆的租期。原期费用、里程、赠送和已收原押金保持原记录；方案确认、协议签署归档、资金核清与正式生效分别办理。</view>
      <view wx:if="{{!change.isEffective}}" class="notice">当前租期继续按原已生效条款执行。这里的新增费用和赠送尚未替换当前规则。</view>
      <block wx:if="{{change.quote}}">
        <view class="card"><view class="section-title">{{change.isEffective ? '已生效的续期租期' : '本次拟续租期'}}</view><view>{{change.quote.periodText}}</view><view class="muted">{{change.quote.productName}} · {{change.quote.months}} 个月</view><view class="price">{{change.quote.monthlyFeeText}} / 月</view><view>新增月费合计 {{change.quote.totalText}}</view><view>原冻结押金 {{change.quote.depositText}} · 保持不变</view><view class="muted small">客户确认截止 {{change.quote.expiresAtText}}</view></view>
        <view class="card"><view class="section-title">新增租期的里程与换车规则</view><view>每服务月基础 {{change.quote.usagePricing.baseAllowanceKm}} km</view><view>超里程 {{change.quote.usagePricing.excessPriceText}} / km</view><view>新增合同期赠送 {{change.quote.swapPolicy.includedCount}} 次</view><view>另购每次 {{change.quote.swapPolicy.extraFeeText}}</view><view class="notice">新期规则须正式生效后才适用。旧期免费次数到期不结转；已有付费次数仍依购买时的有效期和金额，不因续期延长。</view></view>
        <view class="card"><view class="section-title">逐期月费</view><view wx:for="{{change.quote.periods}}" wx:key="sequence" class="field"><view>本租期第 {{item.localSequence}} 月 · 订单第 {{item.sequence}} 月</view><view>{{item.periodText}}</view><view>{{item.amountText}} · 到期 {{item.dueDateText}}</view></view><view class="notice">这里只展示冻结安排，不代表已到账。需付款时请从本人的普通账单核对并主动支付。</view></view>
        <view class="card"><view class="section-title">实际出租方</view><view>{{change.quote.lessor.name}}</view><view class="muted">{{change.quote.lessor.subjectType === 'ENTERPRISE' ? '企业' : '个人'}} · {{change.quote.lessor.creditCode}}</view><button class="text-button" bindtap="openRenewalNotice" disabled="{{busy}}">阅读本出租方的必要资料告知 →</button><view class="muted small">{{change.quote.sharingNotice.title}} · 版本 {{change.quote.sharingNotice.version}}</view></view>
        <view class="card"><view class="section-title">本次安排与正式条款</view><view class="label">续期原因</view><view>{{change.quote.reason}}</view><view class="label">资金安排</view><view>{{change.quote.settlementExplanation}}</view><view class="label">取消约定</view><view>{{change.quote.cancellationTerms}}</view><button wx:if="{{!change.isElectronic}}" class="secondary" bindtap="openChangeTerms" disabled="{{busy}}">阅读本版本补充协议</button></view>
      </block>
      <view wx:else class="notice">正式报价尚未发布或资料待核对，暂不能确认。</view>
      <view wx:if="{{change.cancellation}}" class="notice" role="status">{{change.cancellationText}}</view>
      <view wx:if="{{change.stage}}" class="card"><view class="section-title">服务期办理进度</view><view>{{change.statusText}}</view><view>资金安排 {{change.stage.scheduledAtText}}</view><view>实际生效办理 {{change.stage.activatedAtText}}</view></view>
      <view wx:for="{{change.blockers}}" wx:key="index" class="notice">{{item}}</view>
      <view wx:if="{{changeError}}" class="notice" role="alert">{{changeError}}</view><view wx:if="{{message}}" class="notice" role="status">{{message}}</view>
      <block wx:if="{{change.canConfirm}}"><checkbox-group bindchange="onChangeRead"><label class="consent-row"><checkbox value="change" checked="{{changeRead}}" disabled="{{busy}}" color="#231815"/><text>我已完整阅读本版本新增租期、逐期金额、里程和换车规则，同意本版本续期方案。</text></label></checkbox-group><checkbox-group bindchange="onRenewalSharing"><label class="consent-row"><checkbox value="sharing" checked="{{renewalSharingAccepted}}" disabled="{{busy}}" color="#231815"/><text>我已阅读本版本资料告知，单独同意向上列实际出租方提供履约所需资料。</text></label></checkbox-group><button class="primary" bindtap="confirmChange" disabled="{{busy || !changeRead || !renewalSharingAccepted}}" loading="{{busy}}">确认本版本同车续期</button></block>
      <block wx:if="{{change.canReject}}"><view class="field"><view class="label">拒绝本版本的原因</view><textarea class="textarea" value="{{changeRejectReason}}" bindinput="inputChangeRejectReason" maxlength="2000" disabled="{{busy}}"/></view><button class="secondary" bindtap="rejectChange" disabled="{{busy || !changeRejectReason}}">提交拒绝意见</button></block>
      <button wx:if="{{change.contract.id}}" class="secondary" bindtap="openChangeContract" disabled="{{busy}}">查看本次补充协议与归档进度</button><button class="secondary" bindtap="reload" disabled="{{busy}}">刷新本条续期记录</button><button class="text-button" bindtap="openList">查看全部续期记录 →</button>
    </block><block wx:elif="{{type === 'orderchanges' && change}}">
      <view class="eyebrow">{{change.isSwap ? 'VEHICLE CHANGE / 换车' : 'DELIVERY / 延期交车'}}</view><view class="title">{{change.title}}</view>
      <view class="record-summary"><text class="tag">{{change.statusText}}</text><view class="muted">流程版本 {{change.revision}} · 记录 {{change.id}}</view></view>
      <view wx:if="{{change.isSwap}}" class="notice">换车保留原订阅期限、月界、原服务期每月包含里程及本订阅里程包余额，不因换车重新发放。旧车先交还、新车再交付，双侧事实和签署分别核对；申请、报价预占不代表免费次数已消费。</view><view wx:else class="notice">延期方案不增加订阅月数。客户确认、补充协议签署、资金核对与方案生效分别记录；签署完成不代表已经交车，不会自动扣款或退款。</view>
      <view wx:if="{{change.reason}}" class="card"><view class="section-title">{{change.isSwap ? '换车原因' : '延期原因'}}</view><view>{{change.reason}}</view></view>
      <view wx:if="{{change.isSwap}}" class="card"><view class="section-title">两侧车辆与当前交付进度</view><block wx:if="{{change.originalAssignment}}"><view class="label">本次旧车（原分配记录）</view><view>{{change.originalAssignment.vehicle.title}}</view><view class="muted small">{{change.originalAssignment.vehicle.plateNumber}} · VIN {{change.originalAssignment.vehicle.vin}} · {{change.originalAssignment.statusText}}</view></block><block wx:if="{{change.currentAssignment}}"><view class="label">当前分配车辆</view><view>{{change.currentAssignment.vehicle.title}}</view><view class="muted small">{{change.currentAssignment.vehicle.plateNumber}} · VIN {{change.currentAssignment.vehicle.vin}}</view></block><view wx:else class="notice">当前暂无分配车辆，旧车已交还时需等待新车真实交付，不能继续将旧车当作当前用车。</view><view class="label">本方案目标车辆</view><view>{{change.targetVehicle ? change.targetVehicle.title : '目标车辆尚待正式报价'}}</view><view wx:if="{{change.targetVehicle}}" class="muted small">{{change.targetVehicle.plateNumber}} · VIN {{change.targetVehicle.vin}}</view><view wx:if="{{change.actualCompletedAtText}}" class="notice">实际换车完成 {{change.actualCompletedAtText}}<view class="muted small">登记时间 {{change.recordedAtText}}；次数按本单已冻结约定与实际完成事实核对。</view></view></view><block wx:if="{{change.quote}}"><view wx:if="{{change.quote.isRecovery}}" class="notice">本次仅重新确认日期、交接和无车期间安排，费用沿用此前已签且核清的资金方案，不新增或重复收退款。请重新阅读本版本完整补充条款；拒绝本次未签新安排时，回读最近已签方案，已完成交接事实保留。</view>
        <view class="card"><view class="label">客户首次确认截止时间</view><view>{{change.quote.expiresAtText}}</view><view class="muted">仅限制首次确认；已经确认的版本仍可按流程继续签署、查询和查阅历史，签章授权有效期单独核验。</view></view>
        <view wx:if="{{change.quote.confirmationExpired}}" class="notice" role="alert">本版本客户确认期限已过，不能再确认。请联系运营出具新报价并重新复核、发布；原版本记录保留。</view>
        <view wx:if="{{change.status === 'AWAITING_CONFIRMATION' && !change.quote.confirmationDeadlineValid}}" class="notice" role="alert">本版本确认期限待核对，暂不能确认，请联系运营。</view>
        <view class="card"><view class="section-title">本次正式方案 · 报价版本 {{change.quote.revision}}</view><view class="detail-row"><text class="muted">{{change.isSwap ? '原起租日（保持）' : '新起租日'}}</text><text class="detail-value">{{change.quote.newStartDateText}}</text></view><view class="detail-row"><text class="muted">{{change.isSwap ? '原结束日（保持）' : '新结束日'}}</text><text class="detail-value">{{change.quote.newEndDateText}}</text></view><view class="detail-row"><text class="muted">订阅月数</text><text class="detail-value">{{change.quote.months}}个月（保持原月数）</text></view><view>{{change.quote.reason}}</view></view>
        <view wx:if="{{change.isSwap}}" class="card"><view class="section-title">换车安排与逐项费用</view><view class="label">本版本冻结旧车身份</view><view>{{change.quote.oldVehicleIdentification}}</view><view class="label">本版本冻结新车身份</view><view>{{change.quote.targetVehicleIdentification}}</view><view class="label">预计旧车交还</view><view>{{change.quote.plannedReturnAtText}}</view><view class="label">预计新车交付</view><view>{{change.quote.plannedDeliveryAtText}}</view><view class="detail-row"><text>新月费</text><text>{{change.quote.newMonthlyFeeAmountText}}</text></view><view class="detail-row"><text>本次约定押金</text><text>{{change.quote.depositAmountText}}</text></view><view class="muted">{{change.quote.depositBasis}}</view><view class="detail-row"><text>押金补收</text><text>{{change.quote.depositChargeAmountText}}</text></view><view class="detail-row"><text>押金退还</text><text>{{change.quote.depositRefundAmountText}}</text></view><view class="detail-row"><text>交接费</text><text>{{change.quote.handoverFeeAmountText}}</text></view><view class="muted">{{change.quote.handoverFeeBasis}}</view><view class="label">保险及责任</view><view>{{change.quote.insuranceResponsibility}}</view><view class="label">无车间隔及费用安排</view><view>{{change.quote.downtimeArrangement}}</view><view class="notice">{{change.quote.financialGateText}}</view><view class="muted small">不自动扣押金或付款。免费次数按实际完成时所属周期优先使用；未用免费次数不结转，预占尚未消费。付费次数须另行购买并经可信到账，未到账或冻结次数不可用。</view></view><view class="card"><view class="section-title">{{change.quote.isRecovery ? '沿用的原已签资金安排' : '逐期费用与原款安排'}}</view><view class="notice">{{change.quote.isRecovery ? '以下是沿用的原资金安排，已履行部分不再次履行；实际未结金额请查看下方当前资金核对进度及原账单。' : '金额和期间均来自已复核方案。原付款沿用不代表再次到账；应补、应退分列，不以负数抵充或自动扣押金。'}}</view>
          <view wx:for="{{change.quote.periods}}" wx:key="sequence" class="field">
            <view class="section-title">第 {{item.sequence}} 月</view><view>{{item.periodText}}</view><view class="muted">协商付款到期日 {{item.dueDateText}}</view>
            <view class="detail-row"><text class="muted">本期应付</text><text class="detail-value">{{item.amountText}}</text></view><view class="detail-row"><text class="muted">原期金额</text><text class="detail-value">{{item.originalAmountText}}</text></view><view class="detail-row"><text class="muted">原款净实收</text><text class="detail-value">{{item.netPaidAmountText}}</text></view><view class="detail-row"><text class="muted">本期沿用原款</text><text class="detail-value">{{item.carryAmountText}}</text></view><view class="detail-row"><text class="muted">{{change.quote.isRecovery ? '原方案补收' : '本期补收'}}</text><text class="detail-value">{{item.chargeAmountText}}</text></view><view class="detail-row"><text class="muted">{{change.quote.isRecovery ? '原方案退款' : '本期退款'}}</text><text class="detail-value">{{item.refundAmountText}}</text></view><view class="muted">计算依据：{{item.calculationBasis}}</view>
          </view>
        </view>
        <view class="card"><view class="section-title">逐单协商安排</view><view class="label">资金结算与补偿安排</view><view>{{change.quote.settlementExplanation}}</view><view class="label">交接安排</view><view>{{change.quote.handoverArrangement}}</view><view class="label">取消与履约异常安排</view><view>{{change.quote.cancellationTerms}}</view></view>
        <view wx:if="{{!change.isElectronic}}" class="card"><view class="section-title">本方案固定的正式补充条款</view><block wx:if="{{change.quote.document}}"><view class="muted">文案版本 v{{change.quote.document.version}}</view><button class="text-button" bindtap="openChangeTerms">阅读本方案固定的完整补充条款 →</button></block><view wx:else class="notice">正式{{change.isSwap ? '换车' : '延期'}}补充条款尚不可用，不能确认或发起签署，请联系运营。</view></view>
      </block>
      <view wx:else class="card"><view class="section-title">正式方案尚待发布</view><view class="muted">仅展示当前流程状态，未发布草稿不能确认为客户接受，也不能用于签署。</view></view>
      <view wx:if="{{change.contract}}" class="card"><view class="section-title">补充协议</view><button wx:if="{{change.isElectronic}}" class="secondary" bindtap="openChangeContract">查看本次电子协议</button><view>{{change.contract.statusText}}</view><button wx:if="{{!change.isElectronic && change.contract.sourceFileId}}" class="text-button" data-id="{{change.contract.sourceFileId}}" bindtap="openDocument">查看冻结协议 PDF →</button><button wx:if="{{!change.isElectronic && change.contract.signedFileId}}" class="text-button" data-id="{{change.contract.signedFileId}}" bindtap="openDocument">查看已归档签署 PDF →</button></view>
      <view wx:if="{{change.finance.obligations.length || change.finance.refunds.length || change.finance.adjustments.length}}" class="card"><view class="section-title">当前资金核对进度</view><view class="notice">以下只读展示服务端实际分配、补款账单和退款进度。补款需在普通账单中另行核对并主动支付，退款由财务独立处理。</view>
        <button wx:if="{{change.factSettlementId}}" class="secondary" bindtap="openSwapSettlement">查看实际交接结算</button><view wx:for="{{change.finance.obligations}}" wx:key="sequence" class="field"><view>第 {{item.sequence}} 月 · {{item.periodText}}</view><view class="muted">应付 {{item.amountText}} · 原款已分配 {{item.allocatedAmountText}}</view><view>补款 {{item.chargeAmountText}} · {{item.chargeStatusText}}</view><view class="muted">到期日 {{item.dueDateText}}</view><button wx:if="{{item.chargeBillId}}" class="secondary" data-id="{{item.chargeBillId}}" bindtap="openChangeBill">查看本期普通补款账单</button></view>
        <view wx:for="{{change.finance.adjustments}}" wx:key="id" class="field"><view>{{item.title}} · {{item.amountText}}</view><view class="muted">实际已付 {{item.paidAmountText}} · {{item.statusText}} · 到期 {{item.dueDateText}}</view><button class="secondary" data-id="{{item.id}}" bindtap="openChangeBill">查看对应普通账单</button></view><view wx:for="{{change.finance.refunds}}" wx:key="id" class="field"><view>退款 {{item.amountText}}</view><view>{{item.statusText}}</view><view class="muted">退款记录 {{item.id}}</view></view>
      </view>
      <view wx:if="{{change.isSwap}}" class="card"><view class="section-title">两侧物理交接</view><view class="notice">先完成旧车交还，再办理新车交付；签署不等于实际换车完成，只有服务端核对两侧事实后才消费一次。单侧完成后沿原流程继续，不伪撤销已发生的交还。</view><view wx:if="{{change.returnHandover}}" class="field"><view>旧车交还 · {{change.returnHandover.statusText}}</view><view class="muted">{{change.returnHandover.actualAtText}} · 仪表 {{change.returnHandover.readingKm}} km</view><button class="secondary" data-id="{{change.returnHandover.id}}" bindtap="openChangeHandover">{{change.returnHandover.actionText}}</button></view><view wx:else class="muted">旧车交还单尚待运营准备。</view><view wx:if="{{change.deliveryHandover}}" class="field"><view>新车交付 · {{change.deliveryHandover.statusText}}</view><view class="muted">{{change.deliveryHandover.actualAtText}} · 仪表 {{change.deliveryHandover.readingKm}} km</view><button class="secondary" data-id="{{change.deliveryHandover.id}}" bindtap="openChangeHandover">{{change.deliveryHandover.actionText}}</button></view><view wx:else class="muted">新车交付单待旧侧完成及运营准备，尚不代表已经交付。</view></view><view wx:if="{{change.blockers.length || change.finance.blockers.length || change.capabilityNote}}" class="notice"><view wx:for="{{change.blockers}}" wx:key="index">{{item}}</view><view wx:for="{{change.finance.blockers}}" wx:key="index">{{item}}</view><view>{{change.capabilityNote}}</view></view>
      <view wx:if="{{changeError}}" class="notice" role="alert">{{changeError}}</view><view wx:if="{{message}}" class="notice" role="status">{{message}}</view>
      <view wx:if="{{change.canConfirm}}" class="card"><checkbox-group bindchange="onChangeRead"><label class="delay-agreement"><checkbox value="change" checked="{{changeRead}}" disabled="{{busy}}" color="#231815"/><text wx:if="{{change.quote.isRecovery}}">我已阅读本次日期、交接与无车安排调整，确认沿用原已签收费，已完成的交接不重复办理。</text><text>{{change.isSwap ? '我已完整阅读本版本两侧车辆、原期限与月界、逐项费用及资金核清条件、保险责任、无车间隔、次数规则和正式补充条款，同意本版本换车方案。' : '我已完整阅读并确认本版本的新起止日期、逐期费用、原款沿用、补收退款、交接取消安排及正式补充条款。'}}</text></label></checkbox-group><button class="primary" disabled="{{busy || !changeRead}}" loading="{{busy}}" bindtap="confirmChange">{{change.isSwap ? '确认本版本换车方案' : '确认本版本延期方案'}}</button></view>
      <view wx:if="{{change.canReject}}" class="card"><view class="label">如不同意，请说明原因</view><textarea class="textarea" value="{{changeRejectReason}}" bindinput="inputChangeRejectReason" maxlength="500" disabled="{{busy}}" placeholder="请填写拒绝此版本的原因"/><button class="secondary" disabled="{{busy}}" bindtap="rejectChange">拒绝此版本，转人工沟通</button></view>
      <view wx:if="{{change.isOffline}}" class="notice">客户确认 → 线下签署纸质补充协议 → 上传审核并归档 → 财务核清 → 延期条款生效。原租赁合同及历史记录保留，确认不代表已经交车或扣款。</view><button wx:if="{{change.isOffline && change.contract.id}}" class="secondary" bindtap="openChangeContract">查看本版纸质补充协议归档进度</button>
      <button wx:if="{{change.canSign}}" class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="signChange">签署本版本补充协议</button><button wx:if="{{change.canSync}}" class="secondary" disabled="{{busy}}" loading="{{busy}}" bindtap="syncChange">查询签署与资金进度</button><button class="text-button" disabled="{{busy}}" bindtap="reload">刷新真实流程状态</button><button class="text-button back-link" bindtap="openList">查看全部变更记录 →</button>
    </block><block wx:else><view class="eyebrow">RECORD DETAIL / 详情</view><view class="title">{{record.title}}</view
    ><view wx:if="{{type === 'bills'}}" class="card"><view class="section-title">{{record.billDetails.reasonText}}</view><view wx:if="{{record.billDetails.description}}">{{record.billDetails.description}}</view><view wx:if="{{record.billDetails.periodText}}" class="muted">{{record.billDetails.periodText}}</view></view><view class="record-summary"
      ><text class="tag">{{record.statusText}}</text
      ><view class="muted">{{record.subtitle}}</view></view
    ><view wx:if="{{record.amountText}}" class="price detail-amount">{{record.amountText}}</view
    ><view class="card"
      ><view class="label">记录编号</view><view class="record-id">{{record.id}}</view
      ><view wx:for="{{record.details}}" wx:key="label" class="detail-row"
        ><text class="muted">{{item.label}}</text
        ><text class="detail-value">{{item.value}}</text></view
      ></view
    ><view wx:if="{{record.timeline.length}}" class="card"
      ><view class="section-title">记录进度</view
      ><view wx:for="{{record.timeline}}" wx:key="title" class="timeline-row"
        ><view class="timeline-dot {{item.done ? 'done' : ''}}" /><view
          ><view>{{item.title}}</view><view class="muted">{{item.description}}</view></view
        ></view
      ></view
    ><view wx:if="{{record.documents.length}}" class="card"
      ><view class="section-title">相关文件</view
      ><view wx:for="{{record.documents}}" wx:key="index" class="document" data-id="{{item.id}}" bindtap="openDocument"
        ><view>{{item.title || item.name || item}}</view
        ><view class="muted"
          >{{item.description || '点击打开授权文件'}}</view
        ></view
      ></view
    ><view
      wx:if="{{type === 'bills' || type === 'payments' || type === 'contracts'}}"
      class="notice"
      >支付与签署完成后，请刷新查看服务端确认结果。</view
    ><view wx:if="{{message}}" class="notice" role="status">{{message}}</view
    ><view wx:if="{{record.actions.length}}" class="stack"
      ><button
        wx:for="{{record.actions}}"
        wx:key="id"
        class="{{item.id === 'pay' ? 'primary' : 'secondary'}}"
        loading="{{busy}}"
        disabled="{{busy}}"
        data-action="{{item.id}}"
        bindtap="act"
        >{{item.id === 'sign' ? '签署本记录' : item.label}}</button
      ></view
    ><button wx:if="{{type === 'orders'}}" class="secondary" bindtap="openOrderUsage">查看本订阅月里程、里程包及退订结算</button><button wx:if="{{type === 'orders'}}" class="secondary" bindtap="openOrderChanges">查看订阅变更方案与进度</button><button class="text-button back-link" bindtap="openList">查看全部记录 →</button></block></block
  ></view
>
