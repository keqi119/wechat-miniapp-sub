.record-summary {
  margin: 28rpx 0;
}
.record-summary .muted {
  margin-top: 18rpx;
}
.detail-amount {
  margin: 36rpx 0;
  font-size: 56rpx;
}
.record-id {
  font-size: 26rpx;
  overflow-wrap: anywhere;
  margin-bottom: 24rpx;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  border-top: 1rpx solid #e9e7e3;
  padding: 24rpx 0;
  font-size: 28rpx;
}
.detail-value {
  text-align: right;
  max-width: 68%;
  overflow-wrap: anywhere;
}
.timeline-row {
  display: flex;
  gap: 22rpx;
  margin: 26rpx 0;
}
.timeline-row .muted {
  margin-top: 8rpx;
  font-size: 26rpx;
}
.timeline-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #a8aaa1;
  border-radius: 50%;
  margin-top: 10rpx;
}
.timeline-dot.done {
  background: #231815;
  border-color: #231815;
}
.document {
  padding: 22rpx 0;
  border-top: 1rpx solid #e9e7e3;
}
.document .muted {
  margin-top: 10rpx;
  font-size: 26rpx;
}
.back-link {
  margin-top: 36rpx;
}
.legal-snapshot {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.8;
  margin-top: 24rpx;
}
.delay-agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.delay-agreement checkbox {
  flex-shrink: 0;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}
.order-heading { margin: 24rpx 0 28rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.order-heading .tag { flex-shrink: 0; margin-top: 8rpx; }
.order-title { font-size: 40rpx; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
.order-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26rpx 20rpx; }
.order-summary-item:nth-child(4):last-child { grid-column: 1 / -1; }
.order-summary-value { font-size: 29rpx; line-height: 1.5; overflow-wrap: anywhere; }
.order-money { font-size: 36rpx; font-weight: 600; }
.order-guidance { background: #fff6ce; border-left: 3rpx solid #fcc900; padding: 28rpx; margin: 24rpx 0; font-size: 27rpx; line-height: 1.7; }
.order-guidance .section-title { margin: 0 0 12rpx; font-size: 30rpx; }
.order-field + .order-field { margin-top: 20rpx; }
.order-field-value { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 28rpx; line-height: 1.75; }
.order-related-item + .order-related-item { margin-top: 28rpx; padding-top: 28rpx; border-top: 1rpx solid #e9e7e3; }
.related-title { font-size: 29rpx; line-height: 1.6; }
.order-related .tag { flex-shrink: 0; }
.related-description { margin: 14rpx 0 8rpx; font-size: 26rpx; line-height: 1.7; }
.related-amount { font-size: 34rpx; margin-top: 16rpx; }
.related-action { margin-top: 22rpx; }
.order-disclosure { display: flex; justify-content: space-between; gap: 20rpx; padding: 0; text-align: left; background: transparent; font-size: 29rpx; font-weight: 500; }
.order-disclosure text:last-child { flex-shrink: 0; color: #715300; font-size: 25rpx; }
.order-term-section { padding-top: 24rpx; margin-top: 24rpx; border-top: 1rpx solid #e9e7e3; }
.order-term-section .section-title { font-size: 30rpx; margin-top: 0; }
.order-tools { margin: 30rpx 0; }
.order-meta { border-top: 1rpx solid #e9e7e3; padding-top: 28rpx; margin: 36rpx 0; font-size: 25rpx; color: #737970; }
.page.contract-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.contract-heading { margin: 22rpx 0 26rpx; }
.contract-title { font-size: 48rpx; line-height: 1.4; font-weight: 650; overflow-wrap: anywhere; }
.contract-subtitle { color: #737970; font-size: 25rpx; margin-top: 10rpx; }
.contract-guidance { background: #fff2bd; border-left: 4rpx solid #fcc900; padding: 24rpx; font-size: 26rpx; line-height: 1.65; overflow-wrap: anywhere; }
.contract-guidance-title { font-weight: 600; margin-bottom: 8rpx; font-size: 28rpx; }
.contract-vehicle { font-size: 32rpx; font-weight: 600; line-height: 1.5; padding-bottom: 24rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid #e9e7e3; overflow-wrap: anywhere; }
.contract-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx 18rpx; }
.contract-summary-item:nth-child(4):last-child { grid-column: 1 / -1; }
.contract-summary .label { font-size: 24rpx; color: #737970; margin-bottom: 6rpx; }
.contract-summary-value { font-size: 27rpx; overflow-wrap: anywhere; }
.contract-money { font-size: 38rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.contract-lessor { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #e9e7e3; font-size: 27rpx; line-height: 1.7; overflow-wrap: anywhere; }
.contract-progress .section-title, .contract-parties .section-title, .contract-documents .section-title { margin: 0 0 24rpx; font-size: 30rpx; }
.contract-step { display: flex; align-items: flex-start; gap: 20rpx; min-height: 74rpx; font-size: 27rpx; }
.contract-step:last-child { min-height: 40rpx; }
.contract-step-marker { position: relative; width: 20rpx; align-self: stretch; flex-shrink: 0; }
.contract-step-dot { position: relative; z-index: 1; width: 18rpx; height: 18rpx; margin-top: 12rpx; border: 2rpx solid #c6c5bb; border-radius: 50%; background: #ffffff; }
.contract-step-line { position: absolute; top: 28rpx; bottom: -12rpx; left: 8rpx; width: 2rpx; background: #dddcd2; }
.contract-step-title { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.contract-step-status { color: #86887e; flex-shrink: 0; font-size: 24rpx; padding-top: 3rpx; }
.contract-step-DONE .contract-step-dot { background: #231815; border-color: #231815; }
.contract-step-CURRENT .contract-step-dot { background: #fcc900; border-color: #231815; }
.contract-step-CURRENT .contract-step-title { font-weight: 650; }
.contract-step-CURRENT .contract-step-status { color: #715300; }
.contract-step-STOPPED .contract-step-dot { border-color: #926758; }
.contract-party + .contract-party { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #e9e7e3; }
.contract-party-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.contract-party-top .label { font-size: 25rpx; flex: 1; min-width: 0; }
.contract-party-top .tag { flex-shrink: 0; }
.contract-party-name { font-size: 27rpx; overflow-wrap: anywhere; }
.contract-document { width: 100%; background: transparent; text-align: left; display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; padding: 18rpx 0; font-size: 27rpx; }
.contract-document + .contract-document { border-top: 1rpx solid #e9e7e3; }
.contract-document > view { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.contract-document .small { margin-top: 8rpx; }
.contract-document-arrow { color: #715300; font-size: 24rpx; flex-shrink: 0; }
.contract-tools { margin: 20rpx 0; }
.contract-meta { border-top: 1rpx solid #dddcd2; padding-top: 28rpx; margin-top: 28rpx; color: #737970; font-size: 24rpx; }
.contract-meta .label { font-size: 24rpx; }
.contract-meta .record-id { font-size: 24rpx; }
.contract-meta-row { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 14rpx; }
.contract-meta-row > text:first-child { flex-shrink: 0; }
.contract-meta-row > text:last-child { text-align: right; overflow-wrap: anywhere; }
.contract-actions { position: fixed; z-index: 20; bottom: 0; left: 0; right: 0; display: flex; align-items: center; gap: 20rpx; background: #ffffff; border-top: 1rpx solid #dddcd2; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); }
.contract-actions .secondary { width: 36%; flex-shrink: 0; }
.contract-actions .primary { flex: 1; min-width: 0; padding-left: 12rpx; padding-right: 12rpx; }
.contract-action-status { flex: 1; min-width: 0; text-align: center; font-size: 25rpx; color: #737970; overflow-wrap: anywhere; }

/* Bright native 2026-11-02 */
.record-summary{background:#ffffff;border:1rpx solid #e1e1de;border-radius:24rpx;padding:28rpx}.record-id{font-size:24rpx;overflow-wrap:anywhere;color:#65615c}.contract-heading,.order-heading{margin:20rpx 0 24rpx}.contract-title,.order-title{font-size:44rpx;font-weight:600;line-height:1.4}.contract-guidance,.order-guidance{border-radius:16rpx;background:#fff6d8;border-left:0}.contract-actions{background:#ffffff;border-color:#e9e7e3;padding-left:32rpx;padding-right:32rpx}.contract-summary-value,.order-summary-value{overflow-wrap:anywhere}.contract-money,.order-money{font-weight:600}.contract-step-status{font-size:24rpx}.contract-document,.contract-party{border-color:#e9e7e3}.contract-document{min-height:100rpx;gap:18rpx}.contract-document>view{min-width:0;overflow-wrap:anywhere}.contract-meta,.order-meta{font-size:24rpx;color:#65615c}.detail-row{gap:20rpx}.detail-row>text:last-child{overflow-wrap:anywhere;min-width:0}
