.brand-line {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #231815;
}
.brand-lockup { display: flex; align-items: center; gap: 18rpx; }
.brand-wordmark { width: 296rpx; height: 71rpx; flex-shrink: 0; }
.brand-symbol { position: relative; width: 84rpx; height: 84rpx; overflow: hidden; border-radius: 8rpx; background: #fcc900; flex-shrink: 0; }
.brand-image { position: absolute; width: 216rpx; height: 324rpx; left: -66rpx; top: -102rpx; }
.brand-english { display: block; margin-top: 2rpx; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 600; }
.brand {
  font-size: 32rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}
.city {
  font-size: 24rpx;
  color: #696b64;
}
.hero {
  padding: 66rpx 0 56rpx;
}
.hero .eyebrow { display: inline-block; background: #fcc900; color: #231815; padding: 7rpx 14rpx; font-weight: 650; }
.hero-title {
  font-size: 86rpx;
  line-height: 1.18;
  font-weight: 600;
  letter-spacing: -4rpx;
  margin: 28rpx 0;
}
.hero-copy {
  overflow-wrap: anywhere;
  color: #62655c;
  font-size: 29rpx;
  line-height: 1.8;
}
.hero-button {
  margin-top: 36rpx;
  display: inline-flex;
  justify-content: space-between;
}
.hero-caption,
.price-caption {
  font-size: 24rpx;
  color: #74766e;
  line-height: 1.6;
  margin-top: 18rpx;
}
.home-page .text-button, .home-page .secondary, .home-page .faq-trigger { min-height: 44px; }
.section-heading {
  margin: 20rpx 0;
}
.vehicle-preview {
  border: 1rpx solid #dcdcd4;
  margin-bottom: 26rpx;
  background: #ffffff;
}
.photo-surface {
  position: relative;
  height: 260rpx;
  background: #e9eae3;
}
.vehicle-image {
  width: 100%;
  height: 100%;
}
.missing-photo {
  padding-top: 100rpx;
  text-align: center;
  color: #787b71;
  font-size: 24rpx;
}
.photo-status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  font-size: 24rpx;
  background: #f6f6f0;
  padding: 8rpx 14rpx;
}
.preview-body {
  padding: 26rpx;
}
.vehicle-name {
  font-size: 32rpx;
  font-weight: 600;
}
.vehicle-meta {
  margin: 10rpx 0 22rpx;
}
.price-row {
  align-items: baseline;
}
.process {
  margin-top: 58rpx;
}
.process .section-title {
  margin: 18rpx 0 28rpx;
}
.step {
  display: flex;
  gap: 24rpx;
  padding: 23rpx 0;
  border-top: 1rpx solid #e9e7e3;
  font-size: 29rpx;
  line-height: 1.6;
}
.step-number {
  font-size: 24rpx;
  color: #715300;
  font-variant-numeric: tabular-nums;
  padding-top: 5rpx;
}
.step .muted {
  font-size: 24rpx;
}
.faq {
  border-top: 1rpx solid #e9e7e3;
  border-bottom: 1rpx solid #e9e7e3;
  margin-top: 32rpx;
}
.faq-trigger {
  background: transparent;
  padding: 24rpx 0;
  text-align: left;
  font-size: 27rpx;
  line-height: 1.6;
  border-radius: 0;
}
.faq-trigger::after {
  border: 0;
}
.faq-content {
  padding: 0 0 28rpx;
  line-height: 1.8;
}
.footer-note {
  padding: 48rpx 0 20rpx;
  font-size: 24rpx;
  color: #65615c;
  letter-spacing: 3rpx;
}

