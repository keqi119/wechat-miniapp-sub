<web-view wx:if="{{url && !error}}" src="{{url}}" bindload="onWebLoad" binderror="onWebError" bindmessage="onWebMessage"/>
<view wx:else class="page"><view class="eyebrow">SIGNATURE / 电子签署</view><view class="title">核对文档，完成签署。</view><view wx:if="{{loading}}" class="empty">正在读取签署任务…</view><view wx:if="{{error}}" class="notice">{{error}}</view><view class="notice">{{message}}</view><button wx:if="{{task.miniProgram && status !== 'SIGNED'}}" class="primary" bindtap="openMiniProgram">前往签署小程序</button><button class="secondary" bindtap="refreshStatus">查询服务端签署结果</button><button class="text-button" bindtap="back">返回业务记录</button></view>
