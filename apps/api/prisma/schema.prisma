generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum PaymentVerificationStatus {
 AUTHORIZED
 CREATING
 PENDING
 SUCCEEDED
 CLOSED
 FAILED
 EXPIRED
}

model PaymentVerification {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 createdBy String
 authorizationNote String
 amount Int @default(1)
 currency String @default("CNY")
 status PaymentVerificationStatus @default(AUTHORIZED)
 tradeNo String @unique
 expiresAt DateTime
 startedAt DateTime?
 paidAt DateTime?
 providerTransactionId String? @unique
 requestSnapshot Json?
 clientParameters Json?
 leaseToken String?
 leaseUntil DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events PaymentVerificationEvent[]
 @@index([customerId,createdAt])
}

model PaymentVerificationEvent {
 id String @id
 verificationId String
 verification PaymentVerification @relation(fields:[verificationId],references:[id])
 payloadHash String
 createdAt DateTime @default(now())
}

enum Role {
 ADMIN
 OPERATIONS
 FINANCE
 SUPPORT
}
enum ApplicationStatus {
 SUBMITTED
 IN_REVIEW
 NEEDS_INFO
 REJECTED
 CANCELLED
 AWAITING_CONFIRMATION
 FINAL_PLAN_CONFIRMED
}
enum OrderStatus {
 AWAITING_SIGNATURE
 AWAITING_PAYMENT
 AWAITING_HANDOVER
 ACTIVE
 SETTLING
 COMPLETED
 CANCELLED
}
enum BillStatus {
 DRAFT
 REVIEWED
 PENDING
 PAID
 VOID
}
enum PaymentStatus {
 CREATING
 PENDING
 SUCCEEDED
 FAILED
 CLOSED
}
enum SignatureStatus {
 DRAFT
 PENDING
 SIGNED
 REJECTED
 EXPIRED
}
enum VehicleStatus {
 DRAFT
 PUBLISHED
 UNPUBLISHED
 RESERVED
 IN_USE
}
enum DocumentStatus {
 DRAFT
 PUBLISHED
 RETIRED
}
enum RefundStatus {
 PENDING_APPROVAL
 PROCESSING
 SUCCEEDED
 FAILED
 REJECTED
}
enum HandoverStatus {
 DRAFT
 PUBLISHED
 CUSTOMER_CONFIRMED
 OBJECTION_SUBMITTED
 COMPLETED
 SUPERSEDED
}
enum MileageStatus {
 SUBMITTED
 APPROVED
 REJECTED
}
enum ServiceStatus {
 SUBMITTED
 ACCEPTED
 ASSIGNED
 IN_PROGRESS
 COMPLETED
 CANCELLED
}
model AdminUser {
 id String @id @default(cuid())
 username String @unique
 passwordHash String
 name String
 role Role
 active Boolean @default(true)
 createdAt DateTime @default(now())
 sessions AdminSession[]
}
model AdminSession {
 id String @id
 adminId String
 admin AdminUser @relation(fields:[adminId],references:[id])
 csrfToken String
 expiresAt DateTime
 createdAt DateTime @default(now())
}
model Customer {
 id String @id @default(cuid())
 mobile String @unique
 openId String? @unique
 providerCustomerId String? @unique
 legalIdentityFileId String?
 name String @default("")
 drivingYears Int @default(0)
 profile Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions CustomerSession[]
 applications Application[]
 orders Order[]
 files StoredFile[]
 acceptedConsents CustomerConsent[]
 paymentVerifications PaymentVerification[]
}
model CustomerSession {
 id String @id
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 expiresAt DateTime
 createdAt DateTime @default(now())
}
model ModelDefinition {
 id String @id @default(cuid())
 brand String
 name String
 bodyType String @default("")
 description String @default("")
 createdAt DateTime @default(now())
 vehicles Vehicle[]
}
model Vehicle {
 id String @id @default(cuid())
 modelDefinitionId String?
 modelDefinition ModelDefinition? @relation(fields:[modelDefinitionId],references:[id])
 brand String
 model String
 title String
 year Int
 city String
 mileageKm Int
 batteryHealthPercent Int?
 description String @default("")
 conditionDisclosure String @default("")
 coverFileId String?
 mediaFileIds String[] @default([])
 status VehicleStatus @default(DRAFT)
 reservedOrderId String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 plans SubscriptionPlan[]
 applications Application[]
 orders Order[]
}
model SubscriptionPlan {
 id String @id @default(cuid())
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id])
 name String
 months Int
 monthlyFeeAmount Int
 mileagePerMonthKm Int
 excessMileagePriceAmount Int
 energyDescription String
 benefits String[]
 conditions String
 active Boolean @default(false)
 createdAt DateTime @default(now())
 applications Application[]
}
model LegalDocument {
 id String @id @default(cuid())
 type String
 version Int
 title String
 content String
 status DocumentStatus @default(DRAFT)
 confirmedBy String?
 confirmedAt DateTime?
 publishedAt DateTime?
 customerConsents CustomerConsent[]
 createdAt DateTime @default(now())
 @@unique([type,version])
}
model StoredFile {
 id String @id @default(cuid())
 customerId String?
 customer Customer? @relation(fields:[customerId],references:[id])
 adminId String?
 name String
 mimeType String
 size Int
 sha256 String
 storagePath String
 purpose String
 createdAt DateTime @default(now())
}
model Application {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id])
 subscriptionPlanId String
 subscriptionPlan SubscriptionPlan @relation(fields:[subscriptionPlanId],references:[id])
 status ApplicationStatus @default(SUBMITTED)
 profile Json
 consents Json
 idempotencyKey String
 requestHash String
 revision Int @default(0)
 creditRevision Int @default(0)
 creditConsents CreditConsent[]
 creditVerifications CreditVerification[]
 note String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 finalPlans FinalPlan[]
 order Order?
 @@unique([customerId,idempotencyKey])
 @@index([customerId,status])
}
model FinalPlan {
 id String @id @default(cuid())
 applicationId String
 application Application @relation(fields:[applicationId],references:[id])
 revision Int
 commercialTerms Json?
 commercialHash String
 creditVerificationId String?
 creditVerification CreditVerification? @relation(fields:[creditVerificationId],references:[id])
 creditRevision Int?
 creditBand CreditBand?
 creditRuleVersion String?
 usagePolicyVersion String?
  usagePolicy Json?
 monthlyFeeAmount Int
 depositAmount Int
 months Int
 mileagePerMonthKm Int
 excessMileagePriceAmount Int
 energyDescription String
 benefits String[]
 conditions String
 startDate DateTime @db.Date
 firstDueDate DateTime @db.Date
 createdAt DateTime @default(now())
 @@unique([applicationId,revision])
}
enum CreditBand {
 GE750
 B700_749
 B650_699
 LT650
 UNVERIFIABLE
}
enum CreditConsentStatus {
 ACCEPTED
 DECLINED
 WITHDRAWN
}
model CreditConsent {
 id String @id @default(cuid())
 applicationId String
 application Application @relation(fields:[applicationId],references:[id])
 customerId String
 documentId String
 version Int
 status CreditConsentStatus
 revision Int
 acceptedAt DateTime?
 withdrawnAt DateTime?
 withdrawalKey String?
 idempotencyKey String
 requestHash String
 createdAt DateTime @default(now())
 verifications CreditVerification[]
 @@unique([applicationId,idempotencyKey])
 @@unique([applicationId,revision])
}
model CreditVerification {
 id String @id @default(cuid())
 applicationId String
 application Application @relation(fields:[applicationId],references:[id])
 consentId String
 consent CreditConsent @relation(fields:[consentId],references:[id])
 band CreditBand
 revision Int
 ruleVersion String
 verifiedBy String
 verifiedAt DateTime @default(now())
 idempotencyKey String
 requestHash String
 finalPlans FinalPlan[]
 @@unique([applicationId,idempotencyKey])
 @@unique([applicationId,revision])
}
model Order {
 id String @id @default(cuid())
 applicationId String @unique
 application Application @relation(fields:[applicationId],references:[id])
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id])
 status OrderStatus @default(AWAITING_SIGNATURE)
 finalPlanSnapshot Json
 confirmedMileageKm Int
 cancellationReason String?
 terminationFileId String?
 cancelledAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 contracts Contract[]
 bills Bill[]
 handovers Handover[]
 mileages Mileage[]
 entitlements Entitlement[]
 usageAccount UsageAccount?
}
model Contract {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 kind String @default("SUBSCRIPTION")
 documentId String?
 templateVersion Int?
 body String @default("")
 sourceFileId String?
 documentHash String
 status SignatureStatus @default(DRAFT)
 providerTaskId String? @unique
 signingLeaseUntil DateTime?
 signedFileId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Bill {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 type String
 sequence Int
 amount Int
 paidAmount Int @default(0)
 description String @default("")
 evidenceFileIds String[] @default([])
 createdBy String?
 reviewedBy String?
 reviewedAt DateTime?
 reviewNote String?
 idempotencyKey String?
 dueDate DateTime @db.Date
 status BillStatus @default(DRAFT)
 createdAt DateTime @default(now())
 payments Payment[]
 @@unique([orderId,type,sequence])
 @@unique([orderId,idempotencyKey])
}
model Payment {
 id String @id @default(cuid())
 billId String
 bill Bill @relation(fields:[billId],references:[id])
 customerId String
 amount Int
 status PaymentStatus @default(CREATING)
 idempotencyKey String
 providerTransactionId String? @unique
 clientParameters Json?
 requestSnapshot Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 refunds Refund[]
 @@unique([customerId,idempotencyKey])
}
model Refund {
 id String @id @default(cuid())
 paymentId String
 payment Payment @relation(fields:[paymentId],references:[id])
 customerId String
 amount Int
 reason String
 status RefundStatus @default(PENDING_APPROVAL)
 requestedBy String
 idempotencyKey String?
 approvedBy String?
 providerRefundId String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([requestedBy,idempotencyKey])
}
model DepositEntry {
 id String @id @default(cuid())
 customerId String
 orderId String
 paymentId String?
 refundId String?
 type String
 amount Int
 createdAt DateTime @default(now())
 @@unique([paymentId,type])
 @@unique([refundId,type])
}
model Handover {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 type String
 readingKm Int
 actualAt DateTime?
 fileIds String[]
 checklist Json
 manifestHash String
 revision Int @default(1)
 previousHandoverId String? @unique
 resolutionNote String?
 resolvedBy String?
 status HandoverStatus @default(DRAFT)
 customerResponse String?
 responseReason String?
 responseFileIds String[] @default([])
 responseKey String?
 confirmedAt DateTime?
 signatureStatus SignatureStatus @default(DRAFT)
 providerTaskId String? @unique
 signingLeaseUntil DateTime?
 signedFileId String?
 completedAt DateTime?
 createdAt DateTime @default(now())
}
model CustomerConsent {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 documentId String
 document LegalDocument @relation(fields:[documentId],references:[id])
 type String
 version Int
 acceptedAt DateTime @default(now())
 source String
 @@unique([customerId,documentId])
 @@index([customerId,type])
}
model Mileage {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 periodId String?
 period UsagePeriod? @relation(fields:[periodId],references:[id])
 customerId String
 readingKm Int
 recordedAt DateTime
 fileIds String[]
 idempotencyKey String
 status MileageStatus @default(SUBMITTED)
 note String @default("")
 reviewedBy String?
 createdAt DateTime @default(now())
 @@unique([customerId,idempotencyKey])
}
enum UsagePeriodStatus {
 OPEN
 AWAITING_READING
 REVIEW_PENDING
 READY
 SETTLED
 CANCELLED
}
enum PackAccountStatus {
 ACTIVE
 FROZEN
 EXPIRED
}
enum MileagePurchaseStatus {
  REFUND_PENDING
  REFUNDED
 PENDING_PAYMENT
 ACTIVE
 EXPIRED
 VOID
}
enum ReturnSettlementStatus {
 READINGS_REQUIRED
 PENDING_PAYMENT
 DISPUTED
 COMPLETED
}
model UsageAccount {
 id String @id @default(cuid())
 orderId String @unique
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 policyVersion String
 startedOn DateTime @db.Date
 returnedOn DateTime? @db.Date
 returnReadingKm Int?
 packStatus PackAccountStatus @default(ACTIVE)
 revision Int @default(0)
 periods UsagePeriod[]
 purchases MileagePurchase[]
 ledger MileageLedger[]
 settlement ReturnSettlement?
}
model UsagePeriod {
 id String @id @default(cuid())
 accountId String
 account UsageAccount @relation(fields:[accountId],references:[id])
 orderId String
 sequence Int
 startDate DateTime @db.Date
 endDate DateTime @db.Date
 effectiveEndDate DateTime @db.Date
 status UsagePeriodStatus @default(OPEN)
 revision Int @default(0)
 startReadingKm Int?
 endReadingKm Int?
 readingId String?
 usedKm Int?
 baseUsedKm Int?
 packUsedKm Int?
 excessKm Int?
 excessAmount Int?
 billId String? @unique
 reviewNote String @default("")
 settledAt DateTime?
 settlementKey String?
 createdAt DateTime @default(now())
 mileages Mileage[]
 @@unique([orderId,sequence])
}
model MileagePackProduct {
 id String @id
 version Int
 km Int
 amount Int
 active Boolean @default(true)
 purchases MileagePurchase[]
}
model MileagePurchase {
 id String @id @default(cuid())
 accountId String
 account UsageAccount @relation(fields:[accountId],references:[id])
 customerId String
 orderId String
 productId String
 product MileagePackProduct @relation(fields:[productId],references:[id])
 productVersion Int
 applicableFromSequence Int
 km Int
 amount Int
 remainingKm Int @default(0)
 status MileagePurchaseStatus @default(PENDING_PAYMENT)
 billId String @unique
 termsSnapshot Json
 acceptedAt DateTime
 idempotencyKey String
 requestHash String
 paidAt DateTime?
 createdAt DateTime @default(now())
 ledger MileageLedger[]
 @@unique([orderId,idempotencyKey])
}
model MileageLedger {
 id String @id @default(cuid())
 accountId String
 account UsageAccount @relation(fields:[accountId],references:[id])
 packId String
 pack MileagePurchase @relation(fields:[packId],references:[id])
 periodId String?
 type String
 deltaKm Int
 sourceKey String @unique
 createdAt DateTime @default(now())
}
model ReturnSettlement {
 id String @id @default(cuid())
 accountId String @unique
 account UsageAccount @relation(fields:[accountId],references:[id])
 orderId String @unique
 customerId String
 returnedOn DateTime @db.Date
 status ReturnSettlementStatus @default(READINGS_REQUIRED)
 revision Int @default(0)
 disputeReason String @default("")
 resolutionNote String @default("")
 completedAt DateTime?
 createdAt DateTime @default(now())
}
model Entitlement {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 title String
 description String
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
}
model ServiceRequest {
 id String @id @default(cuid())
 customerId String
 orderId String
 type String
 location String
 description String
 mobile String
 fileIds String[]
 idempotencyKey String
 requestHash String
 status ServiceStatus @default(SUBMITTED)
 assigneeId String?
 providerName String?
 contact String?
 note String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([customerId,idempotencyKey])
}
model Notification {
 id String @id @default(cuid())
 customerId String
 title String
 content String
 resourceType String?
 resourceId String?
 readAt DateTime?
 createdAt DateTime @default(now())
}
model AuditLog {
 id String @id @default(cuid())
 actorType String
 actorId String
 action String
 resourceType String
 resourceId String
 data Json
 createdAt DateTime @default(now())
}
model ProviderEvent {
 id String @id @default(cuid())
 provider String
 eventId String
 resourceId String
 payloadHash String
 status String
 createdAt DateTime @default(now())
 @@unique([provider,eventId])
}

model SmsChallenge {
 id String @id @default(cuid())
 mobile String
 codeHash String
 status String
 expiresAt DateTime
 sentAt DateTime @default(now())
 consumedAt DateTime?
 attempts Int @default(0)
 @@index([mobile,sentAt])
}

model ESignAccount {
 id String @id @default(cuid())
 customerId String @unique
 providerCustomerId String? @unique
 registrationStatus String @default("PENDING")
 realNameStatus String @default("NOT_STARTED")
 verificationSource String @default("UNKNOWN")
 verifiedSerialNo String?
 verificationTransactionNo String? @unique
 identityCiphertext String?
 identityVersion Int @default(0)
 verifiedIdentityHash String?
 verificationLeaseUntil DateTime?
 verificationLeaseToken String?
 certStatus String @default("UNKNOWN")
 certSerialNo String?
 verifiedAt DateTime?
 checkedAt DateTime?
 registrationLeaseUntil DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model EnterpriseSeal {
 id String @id @default(cuid())
 sealName String
 organizationName String
 providerCustomerId String
 providerSignatureId String
 status String @default("DRAFT")
 evidenceFileId String
 confirmedBy String?
 confirmedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model SealAuthority {
 id String @id @default(cuid())
 sealId String
 subjectType String
 subjectId String
 authorityType String
 status String @default("ACTIVE")
 requiresTwoPersonApproval Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([sealId,subjectType,subjectId,authorityType])
}
model SignaturePolicy {
 id String @id @default(cuid())
 policyCode String @unique
 policyName String
 kind String
 sealId String
 executionMode String @default("SEQUENTIAL")
 status String @default("DRAFT")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model ESignApproval {
 id String @id @default(cuid())
 kind String
 resourceId String
 customerId String
 documentHash String
 sourceFileId String
 sourcePdfHash String
 slotCoordinates Json
 policyId String
 sealId String
 requesterId String
 approverId String?
 status String @default("PENDING")
 planHash String
 plan Json
 approvedAt DateTime?
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([kind,resourceId,documentHash,policyId])
}
model FadadaTask {
 id String @id @default(cuid())
 kind String
 resourceId String
 customerId String
 documentHash String
 sourcePdfHash String
 sourceFileId String
 approvalId String @unique
 providerEnvelopeId String @unique
 customerProviderId String
 platformProviderId String
 customerTransactionId String @unique
 platformTransactionId String @unique
 status String @default("PREPARED")
 uploadedAt DateTime?
 customerSignedAt DateTime?
 platformSignedAt DateTime?
 sealRequestedAt DateTime?
 signedFileId String?
 signedPdfHash String?
 processingUntil DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([kind,resourceId,documentHash])
}
