generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
 ADMIN
 OPERATIONS
 FINANCE
 SUPPORT
}
enum ApplicationStatus {
 SUBMITTED
 IN_REVIEW
 NEEDS_INFO
 REJECTED
 CANCELLED
 AWAITING_CONFIRMATION
 FINAL_PLAN_CONFIRMED
}
enum OrderStatus {
 AWAITING_SIGNATURE
 AWAITING_PAYMENT
 AWAITING_HANDOVER
 ACTIVE
 COMPLETED
 CANCELLED
}
enum BillStatus {
 DRAFT
 PENDING
 PAID
 VOID
}
enum PaymentStatus {
 CREATING
 PENDING
 SUCCEEDED
 FAILED
 CLOSED
}
enum SignatureStatus {
 DRAFT
 PENDING
 SIGNED
 REJECTED
 EXPIRED
}
enum VehicleStatus {
 DRAFT
 PUBLISHED
 UNPUBLISHED
 RESERVED
 IN_USE
}
enum DocumentStatus {
 DRAFT
 PUBLISHED
 RETIRED
}
enum RefundStatus {
 PENDING_APPROVAL
 PROCESSING
 SUCCEEDED
 FAILED
 REJECTED
}
enum HandoverStatus {
 DRAFT
 PUBLISHED
 CUSTOMER_CONFIRMED
 OBJECTION_SUBMITTED
 COMPLETED
}
enum MileageStatus {
 SUBMITTED
 APPROVED
 REJECTED
}
enum ServiceStatus {
 SUBMITTED
 ACCEPTED
 ASSIGNED
 IN_PROGRESS
 COMPLETED
 CANCELLED
}
model AdminUser {
 id String @id @default(cuid())
 username String @unique
 passwordHash String
 name String
 role Role
 active Boolean @default(true)
 createdAt DateTime @default(now())
 sessions AdminSession[]
}
model AdminSession {
 id String @id
 adminId String
 admin AdminUser @relation(fields:[adminId],references:[id])
 csrfToken String
 expiresAt DateTime
 createdAt DateTime @default(now())
}
model Customer {
 id String @id @default(cuid())
 mobile String @unique
 openId String? @unique
 providerCustomerId String? @unique
 legalIdentityFileId String?
 name String @default("")
 drivingYears Int @default(0)
 profile Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions CustomerSession[]
 applications Application[]
 orders Order[]
 files StoredFile[]
}
model CustomerSession {
 id String @id
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 expiresAt DateTime
 createdAt DateTime @default(now())
}
model ModelDefinition {
 id String @id @default(cuid())
 brand String
 name String
 bodyType String @default("")
 description String @default("")
 createdAt DateTime @default(now())
 vehicles Vehicle[]
}
model Vehicle {
 id String @id @default(cuid())
 modelDefinitionId String?
 modelDefinition ModelDefinition? @relation(fields:[modelDefinitionId],references:[id])
 brand String
 model String
 title String
 year Int
 city String
 mileageKm Int
 batteryHealthPercent Int?
 description String @default("")
 conditionDisclosure String @default("")
 coverFileId String?
 mediaFileIds String[] @default([])
 status VehicleStatus @default(DRAFT)
 reservedOrderId String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 plans SubscriptionPlan[]
 applications Application[]
 orders Order[]
}
model SubscriptionPlan {
 id String @id @default(cuid())
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id])
 name String
 months Int
 monthlyFeeAmount Int
 mileagePerMonthKm Int
 excessMileagePriceAmount Int
 energyDescription String
 benefits String[]
 conditions String
 active Boolean @default(false)
 createdAt DateTime @default(now())
 applications Application[]
}
model LegalDocument {
 id String @id @default(cuid())
 type String
 version Int
 title String
 content String
 status DocumentStatus @default(DRAFT)
 confirmedBy String?
 confirmedAt DateTime?
 publishedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([type,version])
}
model StoredFile {
 id String @id @default(cuid())
 customerId String?
 customer Customer? @relation(fields:[customerId],references:[id])
 adminId String?
 name String
 mimeType String
 size Int
 sha256 String
 storagePath String
 purpose String
 createdAt DateTime @default(now())
}
model Application {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id])
 subscriptionPlanId String
 subscriptionPlan SubscriptionPlan @relation(fields:[subscriptionPlanId],references:[id])
 status ApplicationStatus @default(SUBMITTED)
 profile Json
 consents Json
 idempotencyKey String
 requestHash String
 revision Int @default(0)
 note String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 finalPlans FinalPlan[]
 order Order?
 @@unique([customerId,idempotencyKey])
 @@index([customerId,status])
}
model FinalPlan {
 id String @id @default(cuid())
 applicationId String
 application Application @relation(fields:[applicationId],references:[id])
 revision Int
 commercialHash String
 monthlyFeeAmount Int
 depositAmount Int
 months Int
 mileagePerMonthKm Int
 excessMileagePriceAmount Int
 energyDescription String
 benefits String[]
 conditions String
 startDate DateTime @db.Date
 firstDueDate DateTime @db.Date
 createdAt DateTime @default(now())
 @@unique([applicationId,revision])
}
model Order {
 id String @id @default(cuid())
 applicationId String @unique
 application Application @relation(fields:[applicationId],references:[id])
 customerId String
 customer Customer @relation(fields:[customerId],references:[id])
 vehicleId String
 vehicle Vehicle @relation(fields:[vehicleId],references:[id])
 status OrderStatus @default(AWAITING_SIGNATURE)
 finalPlanSnapshot Json
 confirmedMileageKm Int
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 contracts Contract[]
 bills Bill[]
 handovers Handover[]
 mileages Mileage[]
 entitlements Entitlement[]
}
model Contract {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 kind String @default("SUBSCRIPTION")
 documentId String?
 templateVersion Int?
 body String @default("")
 sourceFileId String?
 documentHash String
 status SignatureStatus @default(DRAFT)
 providerTaskId String? @unique
 signedFileId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Bill {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 type String
 sequence Int
 amount Int
 paidAmount Int @default(0)
 dueDate DateTime @db.Date
 status BillStatus @default(DRAFT)
 createdAt DateTime @default(now())
 payments Payment[]
 @@unique([orderId,type,sequence])
}
model Payment {
 id String @id @default(cuid())
 billId String
 bill Bill @relation(fields:[billId],references:[id])
 customerId String
 amount Int
 status PaymentStatus @default(CREATING)
 idempotencyKey String
 providerTransactionId String? @unique
 clientParameters Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 refunds Refund[]
 @@unique([customerId,idempotencyKey])
}
model Refund {
 id String @id @default(cuid())
 paymentId String
 payment Payment @relation(fields:[paymentId],references:[id])
 customerId String
 amount Int
 reason String
 status RefundStatus @default(PENDING_APPROVAL)
 requestedBy String
 approvedBy String?
 providerRefundId String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model DepositEntry {
 id String @id @default(cuid())
 customerId String
 orderId String
 paymentId String?
 refundId String?
 type String
 amount Int
 createdAt DateTime @default(now())
 @@unique([paymentId,type])
 @@unique([refundId,type])
}
model Handover {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 type String
 readingKm Int
 fileIds String[]
 checklist Json
 manifestHash String
 status HandoverStatus @default(DRAFT)
 customerResponse String?
 responseReason String?
 responseFileIds String[] @default([])
 responseKey String?
 confirmedAt DateTime?
 signatureStatus SignatureStatus @default(DRAFT)
 providerTaskId String? @unique
 signedFileId String?
 completedAt DateTime?
 createdAt DateTime @default(now())
}
model Mileage {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 readingKm Int
 recordedAt DateTime
 fileIds String[]
 idempotencyKey String
 status MileageStatus @default(SUBMITTED)
 note String @default("")
 reviewedBy String?
 createdAt DateTime @default(now())
 @@unique([customerId,idempotencyKey])
}
model Entitlement {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 customerId String
 title String
 description String
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
}
model ServiceRequest {
 id String @id @default(cuid())
 customerId String
 orderId String
 type String
 location String
 description String
 mobile String
 fileIds String[]
 idempotencyKey String
 requestHash String
 status ServiceStatus @default(SUBMITTED)
 assigneeId String?
 providerName String?
 contact String?
 note String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([customerId,idempotencyKey])
}
model Notification {
 id String @id @default(cuid())
 customerId String
 title String
 content String
 resourceType String?
 resourceId String?
 readAt DateTime?
 createdAt DateTime @default(now())
}
model AuditLog {
 id String @id @default(cuid())
 actorType String
 actorId String
 action String
 resourceType String
 resourceId String
 data Json
 createdAt DateTime @default(now())
}
model ProviderEvent {
 id String @id @default(cuid())
 provider String
 eventId String
 resourceId String
 payloadHash String
 status String
 createdAt DateTime @default(now())
 @@unique([provider,eventId])
}

model SmsChallenge {
 id String @id @default(cuid())
 mobile String
 codeHash String
 status String
 expiresAt DateTime
 sentAt DateTime @default(now())
 consumedAt DateTime?
 attempts Int @default(0)
 @@index([mobile,sentAt])
}
