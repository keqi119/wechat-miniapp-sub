FROM node:24.21.0-bookworm-slim AS deps
ARG DEBIAN_MIRROR=http://deb.debian.org
WORKDIR /app
RUN sed -i "s@http://deb.debian.org@${DEBIAN_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/miniprogram/package.json apps/miniprogram/package.json
COPY apps/signing-h5/package.json apps/signing-h5/package.json
RUN pnpm install --frozen-lockfile --filter @chundian/api...
FROM deps AS build
COPY apps/api/prisma apps/api/prisma
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY apps/api/src apps/api/src
RUN pnpm --filter @chundian/api prisma:generate && pnpm --filter @chundian/api build

FROM node:24.21.0-bookworm-slim AS runtime-base
ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s@http://deb.debian.org@${DEBIAN_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates openssl fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
FROM runtime-base AS runtime
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3101 NODE_OPTIONS=--max-old-space-size=256
ENV FADADA_CJK_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=build /app/apps/api/dist /app/apps/api/dist
COPY --from=build /app/apps/api/prisma /app/apps/api/prisma
COPY apps/api/package.json /app/apps/api/package.json
USER node
WORKDIR /app/apps/api
EXPOSE 3101
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:3101/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
