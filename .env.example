# 本地 API 与独立数据库；复制为 .env 后填写占位值。
# 供应商字段见 .env.providers.example；API 不会自动加载 .env.providers.local。
NODE_ENV=development
HOST=127.0.0.1
PORT=3101
BUILD_VERSION=local
# 宁达七模块 MVP：新订单使用线下合同，历史电子签仅保留核对入口。
MVP_V2_ENABLED=true
# 宁达本轮采用人工资料审核；缺省 PROVIDER_REQUIRED，未知值拒绝启动。
# 人工审核不代表线上实名认证通过，不豁免资格/风控/交付审核。
CUSTOMER_IDENTITY_POLICY=MANUAL_REVIEW
NEW_ORDER_CONTRACT_MODE=OFFLINE
ESIGN_NEW_REQUESTS_ENABLED=false
PLATFORM_LEGAL_ENTITY_NAME=上海宁达信息科技有限公司
# 员工命令幂等摘要专用密钥，至少32字节；由密钥管理生成，不填入仓库。
STAFF_COMMAND_DIGEST_KEY=
STAFF_COMMAND_DIGEST_KEY_VERSION=1
# 轮换时保留旧版本摘要密钥的 JSON 映射；只放服务端密钥配置。
STAFF_COMMAND_DIGEST_KEYS_JSON=
# 纸质合同 PDF 中文字体绝对路径（独立于历史法大大字体配置）。
CONTRACT_CJK_FONT_PATH=
ADMIN_ORIGIN=http://127.0.0.1:3100
# Required in production; no trailing slash/path/query/credentials/port.
# Only test/development fixtures may omit these keys and use historical origins.
# PLATFORM_API_ORIGIN=https://api.evsub.ndacar.com
# H5_SIGNING_ORIGIN=https://sign.evsub.ndacar.com
POSTGRES_USER=chundian
POSTGRES_DB=chundian_dev
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://chundian:replace-with-a-random-password@127.0.0.1:55432/chundian_dev
TEST_DATABASE_URL=postgresql://chundian:replace-with-a-random-password@127.0.0.1:55432/chundian_test
JWT_SECRET=replace-with-a-random-secret
SESSION_SECRET=replace-with-a-different-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-admin-password
UPLOAD_DIR=var/uploads
# 仅历史电子签身份数据解密使用；线下流程无须法大大API账户。
# 若已有历史数据，保留并单独备份，不能随升级更换。
ESIGN_IDENTITY_ENCRYPTION_KEY=
# 本地PDF生成须填写可读的中文字体绝对路径；生产镜像内已设置Noto字体路径。
FADADA_CJK_FONT_PATH=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
PORTAL_SMS_ENABLED=false
WECHAT_PAY_ENABLED=false
# 指定申请的一分钱验收报价；默认关闭，配置格式与撤销规则见 docs/controlled-order-pricing.md。
ORDER_ACCEPTANCE_SCOPE_JSON=
# 付费换车次数购买；关闭不影响读取已有购买或核对真实支付/退款结果。
SWAP_CREDIT_PURCHASE_ENABLED=false
FADADA_ENABLED=false
FADADA_ACCOUNT_REGISTER_ENABLED=false
FADADA_REALNAME_VERIFY_ENABLED=false
FADADA_SIGNING_ENABLED=false
# Enterprise owners: onboarding is separate from commercial contracts and scoped auto-signing.
OWNER_ONBOARDING_ENABLED=false
# 法人 H5 独立入口。短信、法人执照档案及页面发布核验后启用。
OWNER_LEGAL_H5_ENABLED=false
# 仅在 H5 可用后切换；阻止旧小程序企业写入，保留读取。
OWNER_LEGAL_H5_ONLY=false
OWNER_CONTRACTS_ENABLED=false
# 仅开放实际车主合同双方本人手动签署；不会满足平台或车主自动盖章门禁。
OWNER_MANUAL_CONTRACTS_ENABLED=false
# 仅开放法人本人办理渠道授权；不启用自动盖章或改变已有授权状态。
OWNER_AUTHORIZATION_ENABLED=false
# 新申请范围版本：1保留旧范围；2须先审定发布owner-auto-sign v2后再切换。
# Scope v3: enterprise platform authority to Xiaolang; use PROVIDER_AUTO_GRANT.
# Keep OWNER_AUTO_SIGNING_ENABLED=false until real signed grants/scope and controlled signing are verified.
OWNER_AUTHORIZATION_SCOPE_VERSION=1
# UNILATERAL_LETTER requires approved letter/notice documents and never grants provider auto-sign permission.
OWNER_AUTHORIZATION_METHOD=PROVIDER_AUTO_GRANT
OWNER_AUTO_SIGNING_ENABLED=false
# 独立技术验证文件；模板批准不代替本人确认/签署或本文件双人用印复核。
TECHNICAL_ACCEPTANCE_SIGNING_ENABLED=false
# 原服务号主机上的独立签约中心。仅部署并验证新前缀后开启。
H5_SIGNING_ENABLED=false
# 既有真实 H5 响应确认的首跳域名；无凭证或 URL query。
H5_SIGNING_PROVIDER_HOSTS=textapi.fadada.com,realnameverify.fadada.com

# Native mini-program signing: explicit switch, exact approved hosts; no automatic fallback.
MINIAPP_SIGNING_ENABLED=false
MINIAPP_SIGNING_PROVIDER_HOSTS=
# Only identity flows: current loaded Fadada H5 page -> face miniapp -> same flow.
MINIAPP_FACE_BRIDGE_ENABLED=false
# Once approved: textapi17.fadada.com,realnameverify16.fadada.com
# Native provider base: https://textapi17.fadada.com/api2/
# Native return: https://mini-api.subauto.keybox.cloud/api/public/esign-return

# Handover location: publish approved privacy/application/notice first, then pin exact DB identities.
# contentHash is SHA-256(JSON.stringify(content)), using apps/api/src/common/data.ts hash().
# See docs/handover-location.md. Missing/mismatched policy disables new location entry.
HANDOVER_LOCATION_POLICY_JSON=
HANDOVER_LOCATION_MAP_ENABLED=false

# V2 only: third-party owner workspace; keep disabled for direct-operation V1
OWNER_WORKSPACE_ENABLED=false

# Contract rent/deposit bills: Beijing due date minus 3 days, every minute.
# Enable only after the deployment preservation audit; does not charge customers.
BILL_AUTO_PUBLISH_ENABLED=false
