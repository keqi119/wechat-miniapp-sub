{
  "name": "chundian-independent-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @chundian/api dev",
    "dev:admin": "pnpm --filter @chundian/admin dev"
  }
}
