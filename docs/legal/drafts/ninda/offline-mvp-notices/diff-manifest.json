  "exactChanges": {
    "usagePolicy": {
      "preserved": [
        "12个月最短订阅期；北京时间原始日号月界",
        "每月1500公里；基础不结转；当期退订保留完整基础额度",
        "超里程150分/公里；先基础后适用包",
        "里程包1000/2000/3000公里，价格80000/150000/200000分",
        "本单包余额结转；购买当期尚未结算及后续期适用；不追溯已结算或更早月份",
        "退订未使用加购里程失效及一般不退费规则；异常收款/未履约等例外仍须核实处理",
        "电池租赁与电费承担的原文规则；押金退款沿用主合同"
      ],
      "removed": [
        "新增订单每12个月赠送1次换车的承诺",
        "800元/次加购换车及叠加的销售承诺",
        "新订单退订时加购换车次数失效的说明"
      ],
      "adapted": [
        "纸质三方合同及平台角色",
        "实际收车后禁止新购里程包，实际收车/正式还车/结清分离",
        "首版不开放新换车/加购换车及相应自助变更；历史权益不抹除",
        "里程包购买仍须单独正式mileage-pack说明和主动同意"
      ]
    },
    "ownerDataSharing": {
      "preserved": [
        "明确本单出租方和四个已支持变量",
        "本单必要订约/履约资料、客户单独选择、查阅更正和撤回联系",
        "不提供其他出租方订单、密码、验证码、信用核验细节或后台账号"
      ],
      "adapted": [
        "接收方从企业扩为企业或个人及经核验有权经办人",
        "主体标识说明兼容个人出租方回退文字，不新增个人证件变量",
        "资料载体为受控页面及归档纸质文件，不依赖新电子签",
        "按当前订单、冻结接收方、告知摘要、同意和当前合作商身份读取",
        "不以告知新增证件查询、征信、营销或代签/电子用印授权"
      ]
    }
